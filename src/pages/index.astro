---
import Layout from "../layouts/Layout.astro";

const APP = "https://login.ollawrite.com";

/*
 * Every claim below describes something the product actually does. No
 * testimonials, customer logos, user counts or statistics — inventing those on
 * a real company's site is not a placeholder, it is a lie with a deadline.
 */
const capabilities = [
  {
    title: "Reads your actual site",
    body: "Pulls robots.txt and your sitemap, then audits your most important pages — rather than guessing from the domain name.",
  },
  {
    title: "Scores what search sees",
    body: "Titles, meta, structured data, readability and internal links, graded per page so you know which ones are dragging.",
  },
  {
    title: "Specialists, not one prompt",
    body: "Research, then a check on that research, then writing, then an edit. Each stage is a separate agent with one job.",
  },
  {
    title: "Grounded drafts",
    body: "The writer only sees the brief and the audit, so what it claims about your business traces back to your pages.",
  },
];

const steps = [
  {
    n: "01",
    title: "Point it at your domain",
    body: "It maps the site and audits the pages that matter, and tells you plainly if the crawl was blocked or incomplete.",
  },
  {
    n: "02",
    title: "Get a brief, not a guess",
    body: "It reads what currently ranks for your topic and turns the gap into a brief a writer can follow.",
  },
  {
    n: "03",
    title: "Draft, critiqued before you see it",
    body: "An editor agent checks the draft against the brief and sends it back if it is thin or unsupported.",
  },
];
---

<Layout
  title="OllaWrite — content that starts with your actual website"
  description="OllaWrite audits your site, researches what ranks, then writes drafts grounded in what it found. Built for teams who are tired of generic AI copy."
>
  <section class="hero">
    <div class="wrap">
      <h1>Content that starts with your&nbsp;actual&nbsp;website.</h1>
      <p class="lead">
        Most AI writing tools start from a prompt and invent the rest. OllaWrite
        starts by reading your site — the pages, the structure, what search sees
        — and writes from what is really there.
      </p>
      <div class="cta">
        <a class="btn" href={APP}>Open the app</a>
        <a class="btn btn--ghost" href="/contact">Talk to us</a>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>What it does</h2>
      <div class="grid">
        {
          capabilities.map((c) => (
            <article class="card">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <span class="n muted">{s.n}</span>
              <div>
                <h3>{s.title}</h3>
                <p class="muted">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="alt">
    <div class="wrap closing">
      <h2>See it against your own site</h2>
      <p class="lead">
        The fastest way to judge it is to point it at a domain you know well and
        see whether the audit tells you anything you did not already know.
      </p>
      <div class="cta">
        <a class="btn" href={APP}>Open the app</a>
        <a class="btn btn--ghost" href="/contact">Ask a question</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vw, 7rem);
  }

  .hero h1 {
    max-width: 18ch;
  }

  .cta {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .alt {
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .steps li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    max-width: 68ch;
  }

  .n {
    font-family: var(--mono);
    font-size: 0.85rem;
    padding-top: 0.3rem;
    min-width: 2.2rem;
  }

  .steps p {
    margin: 0;
  }

  .closing {
    max-width: 62ch;
  }
</style>
