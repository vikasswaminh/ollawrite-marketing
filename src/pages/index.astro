---
import Layout from "../layouts/Layout.astro";

const APP = "https://login.ollawrite.com";

/*
 * MOCKUP CONTENT. Figures, plans and quotes below are illustrative placeholders
 * for layout purposes, not claims of fact.
 *
 * One deliberate exception: testimonials carry role-based attribution rather
 * than invented named people at invented companies, and there are no customer
 * logos. This site is publicly reachable on a real company domain, and a
 * fabricated named endorsement is the one kind of filler that misleads a
 * visitor instead of just standing in for copy.
 */

const stats = [
  { value: "12x", label: "Faster first drafts" },
  { value: "40+", label: "Site signals audited" },
  { value: "9", label: "Checks per page" },
  { value: "4", label: "Specialist agents" },
];

const features = [
  {
    title: "Reads your site first",
    body: "Pulls robots.txt and your sitemap, then audits your real pages before a single word is written.",
  },
  {
    title: "SEO scoring per page",
    body: "Titles, meta, headings, structured data and readability — graded so you know which pages drag.",
  },
  {
    title: "Specialist agents",
    body: "Research, a check on that research, writing, then an edit. Four agents, one job each.",
  },
  {
    title: "Grounded drafts",
    body: "The writer only sees the brief and the audit, so claims trace back to your own pages.",
  },
  {
    title: "Brand voice memory",
    body: "Give it a few samples and it keeps tone consistent across everything it produces.",
  },
  {
    title: "Built-in critic",
    body: "An editor agent rejects thin or unsupported drafts before they ever reach you.",
  },
];

const steps = [
  {
    n: "01",
    title: "Point it at your domain",
    body: "It maps the site and audits the pages that matter, and says plainly if the crawl was blocked or partial.",
  },
  {
    n: "02",
    title: "Get a brief, not a guess",
    body: "It reads what currently ranks for your topic and turns the gap into a brief a writer can follow.",
  },
  {
    n: "03",
    title: "Draft, critiqued first",
    body: "An editor agent checks the draft against the brief and sends it back if it is thin or unsupported.",
  },
  {
    n: "04",
    title: "Publish or export",
    body: "Ship it to your CMS, or take the markdown and do what you like with it.",
  },
];

const useCases = [
  { title: "Blog and SEO", body: "Cluster-aware articles that target one intent per page." },
  { title: "Landing pages", body: "Positioning copy built from what your product pages already claim." },
  { title: "Product copy", body: "Descriptions consistent with the specs on your own site." },
  { title: "Newsletters", body: "Recurring sends drawn from your latest published work." },
];

const testimonials = [
  {
    quote:
      "The audit surfaced three template-level problems we had been shipping for two years. The drafts were almost a side benefit.",
    role: "Head of content, B2B SaaS",
  },
  {
    quote:
      "It is the first tool that did not need me to explain what the company does. It had already read the site.",
    role: "Marketing lead, training provider",
  },
  {
    quote:
      "The critic stage is the difference. We were getting confident nonsense from everything else we tried.",
    role: "Editor, agency",
  },
];

const plans = [
  {
    name: "Starter",
    price: "$29",
    cadence: "/month",
    blurb: "For a single site and one writer.",
    features: ["1 site", "20 drafts a month", "Full page audits", "Markdown export"],
    cta: "Start free",
    featured: false,
  },
  {
    name: "Studio",
    price: "$99",
    cadence: "/month",
    blurb: "For teams publishing every week.",
    features: [
      "5 sites",
      "Unlimited drafts",
      "Brand voice memory",
      "Editor critic stage",
      "CMS export",
    ],
    cta: "Start free",
    featured: true,
  },
  {
    name: "Agency",
    price: "Custom",
    cadence: "",
    blurb: "For teams running many client sites.",
    features: [
      "Unlimited sites",
      "Client workspaces",
      "Shared brand profiles",
      "Priority support",
    ],
    cta: "Talk to us",
    featured: false,
  },
];

const faqs = [
  {
    q: "How is this different from a normal AI writer?",
    a: "Most tools start from your prompt and invent the rest. OllaWrite starts by crawling and auditing your site, so the draft is built from what is actually published rather than from a guess about your business.",
  },
  {
    q: "Does it need access to my CMS?",
    a: "No. It reads what is publicly reachable — the same pages a search engine sees. CMS export is optional and only used when you ask for it.",
  },
  {
    q: "What if my site blocks crawlers?",
    a: "It tells you. A blocked or partial crawl is reported in the audit rather than quietly producing a thin result that looks complete.",
  },
  {
    q: "Can it match our tone of voice?",
    a: "Give it a handful of existing pieces and it keeps tone consistent across everything it writes afterwards.",
  },
  {
    q: "Who owns the output?",
    a: "You do. Drafts are yours to edit, publish or discard.",
  },
];
---

<Layout
  title="OllaWrite — the AI content writer that reads your site first"
  description="OllaWrite audits your website, researches what ranks, then writes drafts grounded in what it found. Four specialist agents, including an editor that rejects thin work."
>
  <!-- Hero — Terminal edition -->
  <section class="relative overflow-hidden bg-neutral-950 border-b border-white/10">

    <!-- Subtle grid bg -->
    <div class="pointer-events-none absolute inset-0"
         style="background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);background-size:48px 48px">
    </div>

    <!-- Lime glow blob top-right -->
    <div class="pointer-events-none absolute -top-32 right-0 h-96 w-96 rounded-full"
         style="background:radial-gradient(circle,#bef26418 0%,transparent 70%)">
    </div>

    <div class="wrap relative z-10 grid items-center gap-12 py-20 lg:grid-cols-2 lg:py-28">

      <!-- Left: headline -->
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-punch/30 bg-punch/10 px-3 py-1 text-xs font-black uppercase tracking-[0.18em] text-punch">
          <span class="h-1.5 w-1.5 rounded-full bg-punch animate-pulse"></span>
          AI content writer
        </span>

        <h1 class="mt-6 text-5xl font-black leading-[1.02] tracking-tight text-white sm:text-6xl lg:text-7xl">
          Your site,<br/>
          already<br/>
          <span class="text-punch">read.</span>
        </h1>

        <p class="mt-6 max-w-md text-base leading-relaxed text-neutral-400">
          Most AI tools start from a prompt and invent the rest.
          OllaWrite reads your actual site first — pages, structure,
          what search sees — then writes from what's really there.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={APP}
            class="group inline-flex items-center gap-2 rounded-lg border-2 border-punch bg-punch px-6 py-3 font-black text-ink transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_24px_#bef26450]"
          >
            Start writing free
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a
            href="#how"
            class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-6 py-3 font-bold text-white/70 transition-all hover:border-white/30 hover:text-white"
          >
            See how it works
          </a>
        </div>

        <p class="mt-4 text-xs text-neutral-600 font-medium tracking-wide">
          No credit card required · Audit your first site in minutes
        </p>
      </div>

      <!-- Right: Terminal window -->
      <div class="rounded-xl border border-white/10 bg-neutral-900 shadow-[0_32px_80px_#00000080] overflow-hidden">

        <!-- Terminal title bar -->
        <div class="flex items-center gap-2 border-b border-white/8 bg-neutral-800/80 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
          <span class="ml-3 flex-1 text-center text-xs text-neutral-500 font-mono">ollawrite — audit</span>
        </div>

        <!-- Terminal body -->
        <div class="p-6 font-mono text-sm space-y-1 min-h-[320px]">

          <!-- Command line -->
          <p class="text-neutral-500">
            <span class="text-punch">~</span>
            <span class="text-neutral-600"> $ </span>
            <span class="text-white">ollawrite audit yourdomain.com</span>
          </p>

          <!-- Output lines — staggered fade-in via CSS animation -->
          <div class="mt-3 space-y-2 terminal-lines">
            <p class="terminal-line terminal-line-1 text-neutral-500">Connecting to yourdomain.com...</p>
            <p class="terminal-line terminal-line-2"><span class="text-punch">✓</span> <span class="text-neutral-300">Sitemap found — <span class="text-white">47 pages</span> indexed</span></p>
            <p class="terminal-line terminal-line-3"><span class="text-punch">✓</span> <span class="text-neutral-300">robots.txt read — crawl allowed</span></p>
            <p class="terminal-line terminal-line-4"><span class="text-punch">✓</span> <span class="text-neutral-300">Scoring SEO signals across all pages...</span></p>
            <p class="terminal-line terminal-line-5"><span class="text-punch">✓</span> <span class="text-neutral-300">Structured data — <span class="text-yellow-400">3 missing schemas</span></span></p>
            <p class="terminal-line terminal-line-6"><span class="text-punch">✓</span> <span class="text-neutral-300">Content quality pass complete</span></p>
            <p class="terminal-line terminal-line-7"><span class="text-punch">✓</span> <span class="text-neutral-300">Reading top-ranking competitors...</span></p>
            <p class="terminal-line terminal-line-8 mt-4 border-t border-white/8 pt-4">
              <span class="text-white font-black">Audit complete.</span>
              <span class="text-neutral-500"> Grade: </span>
              <span class="text-punch font-black text-lg">B+</span>
            </p>
            <p class="terminal-line terminal-line-9 text-neutral-500">→ 3 critical fixes · 8 opportunities · brief ready</p>
            <p class="terminal-line terminal-line-10 mt-2">
              <span class="text-neutral-600">Ready to draft? </span>
              <span class="text-punch">ollawrite draft --brief=audit</span>
              <span class="terminal-cursor inline-block w-2 h-4 bg-punch ml-0.5 align-middle"></span>
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <style is:global>
    /* Staggered terminal line reveal */
    .terminal-line {
      opacity: 0;
      transform: translateY(4px);
      animation: termLine 0.3s ease forwards;
    }
    .terminal-line-1  { animation-delay: 0.4s; }
    .terminal-line-2  { animation-delay: 0.9s; }
    .terminal-line-3  { animation-delay: 1.4s; }
    .terminal-line-4  { animation-delay: 1.9s; }
    .terminal-line-5  { animation-delay: 2.4s; }
    .terminal-line-6  { animation-delay: 2.9s; }
    .terminal-line-7  { animation-delay: 3.3s; }
    .terminal-line-8  { animation-delay: 3.8s; }
    .terminal-line-9  { animation-delay: 4.1s; }
    .terminal-line-10 { animation-delay: 4.5s; }

    @keyframes termLine {
      to { opacity: 1; transform: translateY(0); }
    }

    /* Blinking cursor */
    .terminal-cursor {
      animation: blink 1s step-end infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }
  </style>



  <!-- Stats -->

  <section class="border-b border-ink bg-brand-tint">
    <div class="wrap grid grid-cols-2 gap-8 py-10 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div>
            <p class="text-3xl font-black text-brand sm:text-4xl">{s.value}</p>
            <p class="mt-1 text-sm text-neutral-600">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="border-b border-ink scroll-mt-16">
    <div class="wrap py-16 lg:py-24">
      <p class="eyebrow">What it does</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-black tracking-tight sm:text-4xl">
        Everything a writer would do first, done before the draft.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <article class="card p-6">
              <h3 class="text-lg font-bold">{f.title}</h3>
              <p class="mt-2 text-neutral-700">{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="border-b border-ink bg-neutral-50 scroll-mt-16">
    <div class="wrap py-16 lg:py-24">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-black tracking-tight sm:text-4xl">
        Four agents, each with one job.
      </h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <li class="card p-6">
              <span class="font-mono text-sm font-bold text-brand">{s.n}</span>
              <h3 class="mt-3 text-lg font-bold">{s.title}</h3>
              <p class="mt-2 text-sm text-neutral-700">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Showcase -->
  <section id="showcase" class="border-b border-ink scroll-mt-16">
    <div class="wrap grid items-start gap-12 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="eyebrow">Sample output</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
          A brief you can argue with, then a draft you can ship.
        </h2>
        <p class="mt-5 text-neutral-700">
          Every draft arrives with the brief it was written against and the audit
          findings it drew on, so you can check the reasoning instead of trusting
          it.
        </p>
        <ul class="mt-6 space-y-3">
          {
            [
              "Target intent and the format that currently wins",
              "Section outline with must-cover points",
              "Editor verdict, with the specific changes demanded",
            ].map((t) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink" />
                <span class="text-neutral-700">{t}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card overflow-hidden">
        <div class="border-b border-ink bg-neutral-50 px-5 py-3">
          <span class="text-sm font-bold">Editor verdict</span>
        </div>
        <div class="space-y-4 p-5 text-sm">
          <div class="flex flex-wrap items-center gap-2">
            <!-- Verdict badges stay literal, not brand moments: REWRITE is
                 black, SHIP is lime with BLACK text (13:1), never lime text. -->
            <span
              class="rounded-full border border-ink bg-ink px-2.5 py-0.5 text-xs font-bold text-paper"
              >REWRITE</span
            >
            <span
              class="rounded-full border border-ink bg-punch px-2.5 py-0.5 text-xs font-bold text-ink"
              >SHIP</span
            >
            <span class="text-neutral-500">3 required changes</span>
          </div>
          {
            [
              "Opening does not answer the question until paragraph three.",
              "Claim about pricing is not supported by the audit or the brief.",
              "Two sections cover the same intent — merge them.",
            ].map((issue, i) => (
              <p class="border-l-2 border-neutral-200 pl-3 text-neutral-700">
                <span class="font-bold text-ink">{i + 1}.</span> {issue}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section id="usecases" class="border-b border-ink bg-neutral-50 scroll-mt-16">
    <div class="wrap py-16 lg:py-24">
      <p class="eyebrow">Use cases</p>
      <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
        Written for the pages that earn their keep.
      </h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          useCases.map((u) => (
            <article class="card p-6">
              <h3 class="font-bold">{u.title}</h3>
              <p class="mt-2 text-sm text-neutral-700">{u.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="border-b border-ink">
    <div class="wrap py-16 lg:py-24">
      <p class="eyebrow">What people say</p>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          testimonials.map((t) => (
            <figure class="card flex h-full flex-col p-6">
              <blockquote class="grow text-neutral-700">"{t.quote}"</blockquote>
              <figcaption class="mt-5 border-t border-neutral-200 pt-4 text-sm font-bold">
                {t.role}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="border-b border-ink bg-neutral-50 scroll-mt-16">
    <div class="wrap py-16 lg:py-24">
      <p class="eyebrow">Pricing</p>
      <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
        Straightforward plans.
      </h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          plans.map((p) => (
            <div
              class={`card flex flex-col p-7 ${p.featured ? "border-2 border-brand shadow-lg" : ""}`}
            >
              {p.featured && (
                /* Lime fill, BLACK label — the accessible pairing. */
                <span class="mb-4 self-start rounded-full border border-ink bg-punch px-3 py-1 text-xs font-bold text-ink">
                  Most popular
                </span>
              )}
              <h3 class="text-lg font-bold">{p.name}</h3>
              <p class="mt-1 text-sm text-neutral-600">{p.blurb}</p>
              <p class="mt-5">
                <span class="text-4xl font-black">{p.price}</span>
                <span class="text-neutral-500">{p.cadence}</span>
              </p>
              <ul class="mt-6 grow space-y-2.5">
                {p.features.map((f) => (
                  <li class="flex gap-2.5 text-sm text-neutral-700">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ink" />
                    {f}
                  </li>
                ))}
              </ul>
              <a
                href={p.name === "Agency" ? "/contact" : APP}
                class={`mt-7 rounded-lg border-2 px-5 py-2.5 text-center font-bold ${
                  p.featured
                    ? "border-brand bg-brand text-paper hover:border-brand-deep hover:bg-brand-deep"
                    : "border-ink bg-paper text-ink hover:bg-neutral-100"
                }`}
              >
                {p.cta}
              </a>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-neutral-500">
        Illustrative pricing for this preview.
      </p>
    </div>
  </section>

  <!-- FAQ — redesigned: two-column editorial, always-visible answers -->
  <section id="faq" class="border-b border-ink scroll-mt-16 overflow-hidden">

    <!-- Top bar -->
    <div class="border-b border-ink bg-neutral-900">
      <div class="wrap flex items-center justify-between py-4">
        <p class="text-xs font-black uppercase tracking-[0.25em] text-punch">FAQ</p>
        <span class="text-xs text-neutral-500 uppercase tracking-widest font-bold">{faqs.length} questions</span>
      </div>
    </div>

    <div class="wrap py-0">
      <div class="lg:grid lg:grid-cols-[300px_1fr]">

        <!-- Left: sticky header -->
        <div class="relative border-r border-ink">
          <div class="sticky top-24 p-8 lg:p-10">
            <!-- Giant watermark -->
            <p
              aria-hidden="true"
              class="select-none font-black text-[7rem] leading-none text-neutral-100 -mx-2"
            >
              ?
            </p>
            <h2 class="mt-4 text-2xl font-black tracking-tight lg:text-3xl">
              Questions<br/>worth<br/>asking.
            </h2>
            <p class="mt-4 text-sm text-neutral-600 leading-relaxed max-w-[18ch]">
              Still not answered? We're one message away.
            </p>
            <a
              href="/contact"
              class="mt-6 inline-flex items-center gap-2 rounded-full border-2 border-ink bg-paper px-5 py-2 text-xs font-black uppercase tracking-widest text-ink shadow-[3px_3px_0_0_#bef264] transition-all hover:-translate-y-0.5 hover:shadow-[5px_5px_0_0_#bef264]"
            >
              Ask us →
            </a>
          </div>
        </div>

        <!-- Right: Q&As always visible -->
        <div class="divide-y divide-neutral-200">
          {
            faqs.map((f, i) => (
              <div class={`group px-8 py-10 lg:px-12 lg:py-12 transition-colors hover:bg-neutral-50 ${i === 0 ? "border-t-0" : ""}`}>
                <div class="flex gap-6">
                  <!-- Number -->
                  <span class="shrink-0 mt-1 text-xs font-black tabular-nums text-punch bg-neutral-900 rounded-full w-7 h-7 flex items-center justify-center">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3 class="text-lg font-black text-ink leading-snug lg:text-xl">
                      {f.q}
                    </h3>
                    <p class="mt-3 text-neutral-600 leading-relaxed text-[0.95rem]">
                      {f.a}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

      </div>
    </div>
  </section>

  <!-- Closing CTA — redesigned: split-screen, editorial -->
  <section class="overflow-hidden">
    <div class="lg:grid lg:grid-cols-2 lg:min-h-[480px]">

      <!-- Left: Dark navy editorial panel -->
      <div class="relative bg-brand-deep flex flex-col justify-between p-10 lg:p-16 overflow-hidden">

        <!-- Giant bg text watermark -->
        <p
          aria-hidden="true"
          class="pointer-events-none absolute -bottom-6 -left-4 select-none text-[11rem] font-black leading-none text-white/5 lg:text-[14rem]"
        >
          Write.
        </p>

        <div class="relative z-10">
          <!-- Label -->
          <span class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.2em] text-punch">
            <span class="block h-px w-8 bg-punch"></span>
            Get started
          </span>

          <!-- Headline -->
          <h2 class="mt-6 text-4xl font-black tracking-tight text-white leading-[1.05] sm:text-5xl lg:text-6xl">
            See it against<br/>
            a site you<br/>
            <span class="text-punch">already know.</span>
          </h2>

          <p class="mt-6 max-w-sm text-blue-200 leading-relaxed text-sm">
            The fastest way to judge OllaWrite is to point it at your own domain.
            The audit will tell you something you didn't already know — or it's free.
          </p>
        </div>

        <!-- Bottom: Social proof row -->
        <div class="relative z-10 mt-12 flex flex-wrap gap-6">
          {[
            { val: "12×", label: "faster drafts" },
            { val: "40+", label: "signals audited" },
            { val: "4", label: "specialist agents" },
          ].map((s) => (
            <div>
              <p class="text-2xl font-black text-punch">{s.val}</p>
              <p class="text-xs font-bold uppercase tracking-widest text-blue-300">{s.label}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Black action panel -->
      <div class="relative bg-neutral-900 flex flex-col justify-center p-10 lg:p-16">

        <!-- Input mockup -->
        <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-4 flex items-center gap-3">
          <span class="text-neutral-500 text-sm font-mono shrink-0">https://</span>
          <span class="flex-1 text-white/30 text-sm font-mono">yourdomain.com</span>
          <span class="shrink-0 rounded-md bg-punch px-3 py-1.5 text-xs font-black text-ink">
            Audit →
          </span>
        </div>
        <p class="mt-2 text-[0.7rem] text-neutral-600 font-medium tracking-wide pl-1">
          No login needed for the audit preview.
        </p>

        <!-- Divider -->
        <div class="my-8 flex items-center gap-4">
          <span class="flex-1 h-px bg-white/10"></span>
          <span class="text-xs text-neutral-600 font-bold uppercase tracking-widest">then</span>
          <span class="flex-1 h-px bg-white/10"></span>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col gap-3">
          <a
            href={APP}
            class="group flex items-center justify-between rounded-xl border-2 border-punch bg-punch px-6 py-4 font-black text-ink transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_24px_#bef26440]"
          >
            <span>Start writing free</span>
            <span class="text-lg transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a
