        <!-- Trust badges -->
        <div class="mt-8 flex flex-wrap gap-4">
          {["No credit card", "Cancel anytime", "Your data stays yours"].map((t) => (
            <span class="flex items-center gap-1.5 text-xs text-neutral-500 font-medium">
              <span class="text-punch">✓</span> {t}
