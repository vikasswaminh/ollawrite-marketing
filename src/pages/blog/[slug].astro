---
import Layout from "../../layouts/Layout.astro";
import { BLOG_POSTS } from "../../data/blog";

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const slugify = (s: string): string =>
  s
    .toLowerCase()
    .replace(/['"“”‘’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

// Parse markdown into distinct sections with NO EMOJIS, SIMPLE CLEAN HIGHLIGHTED WORKING BACKLINKS, and extra-highlighted TLDR & Wrapping Up
const parseBlog = (body: string) => {
  const escape = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  const inline = (s: string) =>
    escape(s)
      .replace(
        /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener noreferrer" class="font-bold text-blue-600 underline underline-offset-4 decoration-2 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-1.5 py-0.5 rounded transition-colors cursor-pointer">$1</a>'
      )
      .replace(/\*\*([^\*]+)\*\*/g, '<strong class="font-bold text-slate-900">$1</strong>')
      .replace(/\*([^\*]+)\*/g, '<em class="text-slate-800 font-medium italic">$1</em>');

  const parseTable = (tableBlock: string) => {
    const lines = tableBlock.trim().split("\n").filter((l) => l.trim().startsWith("|"));
    if (lines.length < 2) return "";
    const headers = lines[0]
      .split("|")
      .map((s) => s.trim())
      .filter((_, i, arr) => i > 0 && i < arr.length - 1);
    const rows = lines
      .slice(2)
      .map((line) =>
        line
          .split("|")
          .map((s) => s.trim())
          .filter((_, i, arr) => i > 0 && i < arr.length - 1)
      );

    const ths = headers
      .map((h) => `<th class="px-5 py-3.5 font-bold text-slate-900 border-b-2 border-blue-200">${inline(h)}</th>`)
      .join("");
    const trs = rows
      .map((row, idx) => {
        const tds = row
          .map((cell, cIdx) => {
            const isFirst = cIdx === 0;
            return `<td class="px-5 py-3.5 ${isFirst ? "font-bold text-slate-900" : "text-slate-700"}">${inline(cell)}</td>`;
          })
          .join("");
        const bg = idx % 2 === 0 ? "bg-white" : "bg-blue-50/30";
        return `<tr class="${bg} transition-colors hover:bg-blue-100/50">${tds}</tr>`;
      })
      .join("");

    return `<div class="table-container my-6 overflow-hidden rounded-2xl border-2 border-blue-500 bg-white shadow-xs">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] text-left text-sm">
          <thead>
            <tr class="bg-blue-50 text-xs font-black uppercase tracking-wider text-blue-950">
              ${ths}
            </tr>
          </thead>
          <tbody class="divide-y divide-blue-100">
            ${trs}
          </tbody>
        </table>
      </div>
    </div>`;
  };

  const headings: { id: string; text: string }[] = [];
  
  let tldrHtml = "";
  let keyPointsHtml = "";
  let faqHtml = "";
  let wrappingUpHtml = "";
  let mistakesHtml = "";
  const chapterBoxes: { id: string; title: string; html: string }[] = [];

  // Split by ## sections
  const sections = body.split(/(?=\n## )|^## /g).filter(Boolean);

  sections.forEach((sec) => {
    const raw = sec.trim();
    if (!raw) return;

    const lines = raw.split("\n");
    const firstLine = lines[0].replace(/^##\s*/, "").trim();
    const restLines = lines.slice(1).join("\n").trim();

    // 1. TL;DR Section (EXTRA PROMINENT BLUE HIGHLIGHT, NO EMOJIS)
    if (firstLine === "TL;DR") {
      headings.push({ id: "tldr", text: "TL;DR Summary" });
      const paragraphs = restLines.split(/\n\n+/).map(p => `<p class="text-[1.12rem] leading-relaxed text-slate-900 font-medium mb-3.5 last:mb-0">${inline(p.trim())}</p>`).join("");
      tldrHtml = `
        <section id="tldr" class="my-10 scroll-mt-28 rounded-3xl border-3 border-blue-600 border-l-[12px] border-l-blue-700 bg-gradient-to-br from-blue-50 via-sky-50 to-blue-100/80 p-7 sm:p-10 text-slate-900 shadow-xl shadow-blue-500/10">
          <div class="mb-4">
            <span class="text-xs uppercase tracking-widest font-black text-blue-700 bg-blue-100/80 border border-blue-300 px-3 py-1 rounded-full">Executive Brief</span>
            <h3 class="text-2xl sm:text-3xl font-black tracking-tight text-blue-950 mt-2">TL;DR Summary</h3>
          </div>
          <div class="space-y-3.5">${paragraphs}</div>
        </section>
      `;
      return;
    }

    // 2. Key Points / Key Takeaways Section (Blue Border Container + Blue Border Point Cards, NO EMOJIS)
    if (firstLine === "Key Points" || firstLine === "Key Takeaways") {
      headings.push({ id: "key-takeaways", text: "Key Takeaways" });
      const items = restLines.split("\n").filter(l => l.trim().startsWith("- "));
      const itemsHtml = items.map(item => {
        const text = item.replace(/^-\s*/, "").trim();
        return `<li class="rounded-xl border-2 border-blue-400 bg-white p-4 sm:p-5 shadow-xs flex gap-3.5 items-start">
          <span class="text-blue-600 font-black text-xl leading-none flex-shrink-0 mt-0.5">•</span>
          <div class="text-slate-800 text-[1.02rem] leading-relaxed">${inline(text)}</div>
        </li>`;
      }).join("");

      keyPointsHtml = `
        <section id="key-takeaways" class="my-8 scroll-mt-28 rounded-2xl border-2 border-blue-500 bg-blue-50/40 p-6 sm:p-8 text-slate-900 shadow-md">
          <div class="mb-5">
            <h3 class="text-xl sm:text-2xl font-black text-blue-950">Key Takeaways</h3>
          </div>
          <ul class="space-y-4 list-none p-0 m-0">${itemsHtml}</ul>
        </section>
      `;
      return;
    }

    // 3. Frequently Asked Questions Section (Blue Border Box Container, NO EMOJIS)
    if (firstLine.includes("Frequently Asked Questions")) {
      headings.push({ id: "faq", text: "Frequently Asked Questions" });
      const faqBlocks = restLines.split(/(?=\n### )|^### /g).filter(Boolean);
      const faqItemsHtml = faqBlocks.map(block => {
        const bLines = block.trim().split("\n");
        const q = bLines[0].replace(/^###\s*/, "").trim();
        const a = bLines.slice(1).join("\n").trim().split(/\n\n+/).map(p => `<p class="text-slate-700 leading-relaxed text-[1.02rem] mb-2 last:mb-0">${inline(p.trim())}</p>`).join("");
        return `
          <details class="faq-item group border-2 border-blue-400 rounded-xl bg-white p-5 transition-all hover:border-blue-600 open:border-blue-600 open:bg-blue-50/30 shadow-xs">
            <summary class="flex cursor-pointer list-none items-center justify-between font-bold text-slate-900 hover:text-blue-700 transition-colors">
              <span class="text-base sm:text-lg pr-4 font-black text-slate-900">${inline(q)}</span>
              <span class="faq-toggle-badge inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-50 border border-blue-300 text-blue-600 font-bold transition-transform group-open:bg-blue-600 group-open:text-white">
                <span class="group-open:hidden text-base font-bold">+</span>
                <span class="hidden group-open:inline text-base font-bold">−</span>
              </span>
            </summary>
            <div class="mt-4 pt-3 border-t border-blue-100 space-y-2 font-normal">
              ${a}
            </div>
          </details>
        `;
      }).join("");

      faqHtml = `
        <section id="faq" class="my-10 scroll-mt-28 rounded-3xl border-2 border-blue-500 bg-slate-50/60 p-6 sm:p-10 shadow-md">
          <div class="mb-6 border-b border-blue-200 pb-4">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900">Frequently Asked Questions</h2>
          </div>
          <div class="space-y-4">${faqItemsHtml}</div>
        </section>
      `;
      return;
    }

    // 4. Wrapping Up Section (MEDIUM SIZE, BALANCED SPACING, SAME HIGHLIGHTS & SIGNUP)
    if (
      firstLine.startsWith("Wrapping Up") ||
      firstLine.startsWith("Final Verdict") ||
      firstLine.startsWith("Final Thoughts")
    ) {
      headings.push({ id: "wrapping-it-up", text: "Wrapping It Up" });
      const paragraphs = restLines.split(/\n\n+/).map(p => `<p class="text-slate-800 text-[1rem] sm:text-[1.05rem] leading-relaxed mb-3 last:mb-0 font-normal">${inline(p.trim())}</p>`).join("");
      wrappingUpHtml = `
        <section id="wrapping-it-up" class="my-8 scroll-mt-28 rounded-2xl border-2 border-blue-500 bg-gradient-to-br from-blue-50 via-sky-50 to-blue-100/80 p-6 sm:p-8 text-center shadow-md">
          <div class="mb-3">
            <span class="text-xs uppercase tracking-widest font-black text-blue-700 bg-blue-100/90 border border-blue-300 px-3 py-1 rounded-full">Final Take</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-950 mb-4 tracking-tight">Wrapping It Up</h2>
          <div class="space-y-3 max-w-3xl mx-auto mb-6 text-left sm:text-center">${paragraphs}</div>
          <div class="flex justify-center">
            <a href="https://login.ollawrite.com" class="inline-flex items-center justify-center font-bold px-8 py-3 text-base sm:text-lg rounded-xl bg-blue-600 hover:bg-blue-700 text-white shadow-md hover:scale-105 transition-all">
              Start free with OllaWrite →
            </a>
          </div>
        </section>
      `;
      return;
    }

    // 5. Mistakes Section (Blue Border Container + Red Highlighted Sub-Titles, NO EMOJIS)
    if (firstLine.toLowerCase().includes("mistake")) {
      const id = slugify(firstLine);
      headings.push({ id, text: firstLine });
      const linesArr = restLines.split("\n");
      const introParas: string[] = [];
      const mistakeItems: string[] = [];

      linesArr.forEach(l => {
        const trimmed = l.trim();
        if (trimmed.startsWith("- ")) {
          const rawItem = trimmed.replace(/^-\s*/, "");
          const boldMatch = rawItem.match(/^\*\*(.*?)\*\*:\s*(.*)$/);
          if (boldMatch) {
            const mTitle = boldMatch[1];
            const mDesc = boldMatch[2];
            mistakeItems.push(`
              <li class="rounded-xl border-2 border-blue-400 bg-red-50/30 p-5 sm:p-6 shadow-sm transition-all hover:border-red-500 flex flex-col gap-2">
                <span class="text-red-600 font-black text-base sm:text-lg tracking-tight">${inline(mTitle)}</span>
                <p class="text-slate-700 text-[1.02rem] leading-relaxed m-0 font-normal">${inline(mDesc)}</p>
              </li>
            `);
          } else {
            mistakeItems.push(`
              <li class="rounded-xl border-2 border-blue-400 bg-red-50/30 p-5 sm:p-6 shadow-sm flex gap-3.5 items-start">
                <span class="text-red-600 font-black text-xl leading-none flex-shrink-0 mt-0.5">•</span>
                <div class="text-slate-700 text-[1.02rem] leading-relaxed">${inline(rawItem)}</div>
              </li>
            `);
          }
        } else if (trimmed) {
          introParas.push(`<p class="text-slate-700 text-[1.12rem] leading-relaxed mb-4">${inline(trimmed)}</p>`);
        }
      });

      mistakesHtml = `
        <section id="${id}" class="chapter-box my-8 scroll-mt-28 rounded-2xl border-2 border-blue-500 bg-white p-6 sm:p-8 shadow-xs">
          <div class="flex items-center justify-between mb-6 border-l-4 border-red-600 pl-4">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900">${inline(firstLine)}</h2>
            <span class="text-xs uppercase tracking-wider font-black px-3 py-1 bg-red-100 text-red-700 rounded-full border border-red-200">Critical Pitfalls</span>
          </div>
          ${introParas.join("")}
          <ul class="space-y-4 list-none p-0 m-0 mt-6">${mistakeItems.join("")}</ul>
        </section>
      `;
      return;
    }

    // 6. Regular Chapter Boxes (Blue Border Chapter Cards, NO EMOJIS, SIMPLE HIGHLIGHTED BACKLINKS)
    const id = slugify(firstLine);
    headings.push({ id, text: firstLine });

    const innerBlocks = restLines.split(/\n\n+/);
    const innerHtml: string[] = [];
    let listArr: string[] = [];
    let ordArr: string[] = [];

    const flushInnerList = () => {
      if (listArr.length > 0) {
        innerHtml.push(`<ul class="my-6 space-y-3.5 list-none p-0">${listArr.join("")}</ul>`);
        listArr = [];
      }
      if (ordArr.length > 0) {
        innerHtml.push(`<ol class="my-6 space-y-3.5 list-none p-0">${ordArr.join("")}</ol>`);
        ordArr = [];
      }
    };

    innerBlocks.forEach(blk => {
      const bLines = blk.split("\n");
      bLines.forEach(l => {
        const trimmed = l.trim();
        if (trimmed.startsWith("### ")) {
          flushInnerList();
          const subTitle = trimmed.replace("### ", "").trim();
          const subId = slugify(subTitle);
          innerHtml.push(`
            <div id="${subId}" class="my-6 rounded-2xl border-2 border-blue-300 bg-blue-50/40 p-5 sm:p-6 shadow-xs">
              <h3 class="text-lg sm:text-xl font-black text-slate-900 mb-1">
                ${inline(subTitle)}
              </h3>
            </div>
          `);
          return;
        }

        if (trimmed.startsWith("- ")) {
          const itemText = trimmed.replace(/^-\s*/, "").trim();
          listArr.push(`
            <li class="rounded-xl border-2 border-blue-400 bg-white p-4 sm:p-4.5 shadow-xs flex gap-3.5 items-start">
              <span class="text-blue-600 font-black text-lg leading-none flex-shrink-0 mt-0.5">•</span>
              <span class="text-slate-700 text-[1.02rem] leading-relaxed font-normal">${inline(itemText)}</span>
            </li>
          `);
          return;
        }

        if (/^\d+\.\s/.test(trimmed)) {
          const itemText = trimmed.replace(/^\d+\.\s*/, "").trim();
          ordArr.push(`
            <li class="rounded-xl border-2 border-blue-400 bg-white p-4 sm:p-4.5 shadow-xs flex gap-3.5 items-start">
              <span class="font-black text-blue-600 text-[1.02rem] flex-shrink-0">${ordArr.length + 1}.</span>
              <span class="text-slate-700 text-[1.02rem] leading-relaxed font-normal">${inline(itemText)}</span>
            </li>
          `);
          return;
        }

        flushInnerList();

        if (trimmed.startsWith("|") && trimmed.endsWith("|")) {
          innerHtml.push(parseTable(blk));
        } else if (trimmed) {
          innerHtml.push(`<p class="text-slate-700 text-[1.12rem] leading-relaxed mb-5 font-normal">${inline(trimmed)}</p>`);
        }
      });
    });

    flushInnerList();

    chapterBoxes.push({
      id,
      title: firstLine,
      html: `
        <section id="${id}" class="chapter-box my-8 scroll-mt-28 rounded-2xl border-2 border-blue-400 bg-white p-6 sm:p-8 shadow-xs">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mb-6 border-l-4 border-blue-600 pl-4">
            <a href="#${id}" class="hover:text-blue-600 transition-colors">${inline(firstLine)}</a>
          </h2>
          <div class="chapter-content">${innerHtml.join("")}</div>
        </section>
      `
    });
  });

  return {
    tldrHtml,
    keyPointsHtml,
    faqHtml,
    wrappingUpHtml,
    mistakesHtml,
    chapterBoxes,
    headings,
  };
};

const {
  tldrHtml,
  keyPointsHtml,
  faqHtml,
  wrappingUpHtml,
  mistakesHtml,
  chapterBoxes,
  headings,
} = parseBlog(post.body);

// Exact chapters for sticky TOC sidebar
const tocItems = headings;
---

<Layout title={`${post.title} — OllaWrite`} description={post.excerpt}>
  <!-- Top Reading Progress Bar in Blue -->
  <div id="reading-progress-container" class="fixed top-0 left-0 z-50 h-1.5 w-full bg-blue-100">
    <div id="reading-progress-bar" class="h-full bg-blue-600 w-0 transition-all duration-75"></div>
  </div>

  <div class="max-w-[1360px] mx-auto px-6 py-12 lg:py-16">
    <article class="w-full">
      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b-2 border-blue-200">
        <div class="flex items-center gap-3 text-xs sm:text-sm font-bold text-blue-600 uppercase tracking-wider mb-4">
          <span>{post.category}</span>
          <span>•</span>
          <span>{post.date}</span>
          <span>•</span>
          <span>{post.readTime}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 leading-tight mb-6">
          {post.title}
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-4xl">
          {post.excerpt}
        </p>
      </header>

      <!-- 2-Column Grid Layout: Sticky TOC + Content -->
      <div class="flex flex-col lg:flex-row gap-10 items-start relative w-full">
        <!-- Sticky Sidebar TOC (Blue Border Box) -->
        <aside class="w-full lg:w-[320px] lg:shrink-0 lg:sticky lg:top-24 max-h-[calc(100vh-120px)] overflow-y-auto">
          <div class="rounded-2xl border-2 border-blue-500 bg-white p-5 shadow-sm">
            <div class="pb-3 mb-3 border-b-2 border-blue-100 font-black text-slate-900 text-sm uppercase tracking-wider">
              Table of Contents
            </div>
            <nav class="space-y-1.5">
              {
                tocItems.map((item, index) => (
                  <a
                    href={`#${item.id}`}
                    data-target={item.id}
                    class="toc-sidebar-link flex items-center gap-2.5 rounded-xl border border-transparent px-3 py-2 text-xs font-semibold text-slate-600 transition-all hover:border-blue-300 hover:bg-blue-50/70 hover:text-blue-700"
                  >
                    <span class="toc-num flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-blue-100 text-[0.7rem] font-bold text-blue-700">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="flex-1 truncate">{item.text}</span>
                  </a>
                ))
              }
            </nav>
          </div>
        </aside>

        <!-- Main Content Column -->
        <div class="flex-1 min-w-0 w-full">
          <!-- 1. TL;DR Extra-Highlighted Blue Box -->
          {tldrHtml && <div set:html={tldrHtml} />}

          <!-- 2. Key Takeaways Highlighted Blue Box with Blue Border Points -->
          {keyPointsHtml && <div set:html={keyPointsHtml} />}

          <!-- 3. OVERALL CONTENT BOX (WITH BOLD BLUE BORDER) -->
          <div class="blog-main-content-box my-8 rounded-3xl border-2 border-blue-500 bg-blue-50/20 p-6 sm:p-10 shadow-md">
            <div class="mb-6 pb-4 border-b-2 border-blue-200">
              <h2 class="text-xl sm:text-2xl font-black text-slate-900">Complete Guide & Deep-Dive Analysis</h2>
            </div>

            <!-- Individual Chapter Boxes with Blue Borders Inside the Content Box -->
            {chapterBoxes.map((chap) => <div set:html={chap.html} />)}

            <!-- Mistakes Section Box with Blue Border Inside the Content Box -->
            {mistakesHtml && <div set:html={mistakesHtml} />}
          </div>

          <!-- 4. Standalone FAQ Section Box (With Blue Border) -->
          {faqHtml && <div set:html={faqHtml} />}

          <!-- 5. Wrapping Up Extra-Highlighted Blue Box with CTA -->
          {wrappingUpHtml && <div set:html={wrappingUpHtml} />}

          <!-- Floating Back-to-Top & Copy Pill -->
          <div class="fixed bottom-6 right-6 z-40 flex items-center gap-2 rounded-full border-2 border-blue-500 bg-white/95 p-1.5 shadow-lg backdrop-blur-md">
            <a
              href="#"
              title="Back to Top"
              class="flex h-9 px-3 items-center justify-center rounded-full bg-blue-50 text-xs font-black text-blue-700 hover:bg-blue-600 hover:text-white transition-colors"
            >
              Top
            </a>
            <button
              id="copy-article-link"
              type="button"
              title="Copy link to clipboard"
              class="flex h-9 px-3 items-center justify-center rounded-full bg-blue-50 text-xs font-bold text-blue-700 hover:bg-blue-600 hover:text-white transition-colors"
            >
              Share
            </button>
          </div>
        </div>
      </div>
    </article>
  </div>

  <!-- Toast for Copy Link -->
  <div
    id="copy-toast"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transform opacity-0 pointer-events-none transition-all duration-300 rounded-full border border-blue-700 bg-slate-950/95 backdrop-blur-md px-5 py-2.5 text-xs font-semibold text-white shadow-2xl"
  >
    Copied link to clipboard
  </div>

  <script>
    // 1. Reading progress bar
    const bar = document.getElementById("reading-progress-bar");
    const updateProgress = () => {
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollHeight > 0 && bar) {
        const pct = (window.scrollY / scrollHeight) * 100;
        bar.style.width = Math.min(100, Math.max(0, pct)) + "%";
      }
    };
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();

    // 2. Active TOC Scroll Spy
    const headings = document.querySelectorAll("article h2[id], article h3[id], section[id]");
    const tocLinks = document.querySelectorAll(".toc-sidebar-link");

    const updateActiveToc = () => {
      let currentId = "";
      const scrollPos = window.scrollY + 160;

      headings.forEach((heading) => {
        const top = (heading as HTMLElement).offsetTop;
        if (scrollPos >= top) {
          currentId = heading.id;
        }
      });

      tocLinks.forEach((link) => {
        const target = link.getAttribute("data-target");
        if (target === currentId) {
          link.classList.add("border-blue-500", "bg-blue-50", "text-blue-700", "font-bold");
          link.classList.remove("border-transparent", "text-slate-600");
        } else {
          link.classList.remove("border-blue-500", "bg-blue-50", "text-blue-700", "font-bold");
          link.classList.add("border-transparent", "text-slate-600");
        }
      });
    };
    window.addEventListener("scroll", updateActiveToc, { passive: true });
    updateActiveToc();

    // 3. Copy Link Toast
    const copyBtn = document.getElementById("copy-article-link");
    const toast = document.getElementById("copy-toast");
    copyBtn?.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        if (toast) {
          toast.classList.remove("opacity-0", "pointer-events-none");
          toast.classList.add("opacity-100");
          setTimeout(() => {
            toast.classList.remove("opacity-100");
            toast.classList.add("opacity-0", "pointer-events-none");
          }, 2500);
        }
      });
    });
  </script>
</Layout>
