---
import Layout from "../../layouts/Layout.astro";
import { BLOG_POSTS } from "../../data/blog";

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const slugify = (s: string): string =>
  s
    .toLowerCase()
    .replace(/['"“”‘’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

// Render the lightweight markdown body into HTML blocks.
const renderBody = (body: string): { html: string; headings: { id: string; text: string }[] } => {
  const escape = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  const inline = (s: string) =>
    escape(s)
      .replace(
        /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
        '<a href="$2" class="font-bold text-indigo-600 underline underline-offset-4 decoration-indigo-300 hover:decoration-indigo-600 hover:text-indigo-800 transition-all">$1</a>'
      )
      .replace(/\*\*(.+?)\*\*/g, '<strong class="font-bold text-slate-900">$1</strong>')
      .replace(/\*(.+?)\*/g, '<em class="text-slate-800 font-medium">$1</em>');

  const li = (item: string) => {
    const text = item.replace(/^-\s*/, "");
    return `<li class="flex gap-3.5 items-start"><span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 shadow-sm ring-4 ring-indigo-50"></span><span class="text-slate-700 leading-relaxed font-normal">${inline(
      text
    )}</span></li>`;
  };

  const parseTable = (tableBlock: string) => {
    const lines = tableBlock.trim().split("\n").filter((l) => l.trim().startsWith("|"));
    if (lines.length < 2) return "";
    const headers = lines[0]
      .split("|")
      .map((s) => s.trim())
      .filter((_, i, arr) => i > 0 && i < arr.length - 1);
    const rows = lines
      .slice(2)
      .map((line) =>
        line
          .split("|")
          .map((s) => s.trim())
          .filter((_, i, arr) => i > 0 && i < arr.length - 1)
      );

    const ths = headers
      .map((h) => `<th class="px-5 py-4 font-black text-slate-900">${inline(h)}</th>`)
      .join("");
    const trs = rows
      .map((row, idx) => {
        const tds = row
          .map((cell, cIdx) => {
            const isFirst = cIdx === 0;
            return `<td class="px-5 py-4 ${isFirst ? "font-bold text-slate-900" : "text-slate-700"}">${inline(cell)}</td>`;
          })
          .join("");
        const bg = idx % 2 === 0 ? "bg-white" : "bg-slate-50/60";
        return `<tr class="${bg} transition-colors hover:bg-indigo-50/50">${tds}</tr>`;
      })
      .join("");

    return `<div class="table-container my-10 overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-[0_12px_36px_rgba(79,70,229,0.06)]">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] text-left text-sm">
          <thead>
            <tr class="border-b-2 border-indigo-100 bg-slate-50/90 text-xs font-black uppercase tracking-wider text-slate-800">
              ${ths}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            ${trs}
          </tbody>
        </table>
      </div>
    </div>`;
  };

  const out: string[] = [];
  const headings: { id: string; text: string }[] = [];
  let list: string[] = [];
  const flushList = () => {
    if (list.length) {
      out.push(`<ul class="my-6 space-y-3.5 pl-1">${list.join("")}</ul>`);
      list = [];
    }
  };

  body.split("\n\n").forEach((block) => {
    const trimmedBlock = block.trim();
    if (trimmedBlock.startsWith("|") && trimmedBlock.includes("\n|")) {
      flushList();
      out.push(parseTable(trimmedBlock));
      return;
    }

    const lines = block.split("\n");
    lines.forEach((line) => {
      const trimmed = line.trim();
      if (trimmed.startsWith("- ")) {
        list.push(li(trimmed));
        return;
      }
      flushList();

      if (trimmed.startsWith("### ")) {
        out.push(
          `<div class="mt-9 mb-5 rounded-2xl border border-indigo-100 bg-gradient-to-r from-white via-indigo-50/40 to-white p-5 shadow-sm hover:border-indigo-300 transition-all"><h3 class="text-lg font-bold text-slate-900 sm:text-xl flex items-center gap-3"><span class="flex h-3.5 w-3.5 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-600 shadow-sm"></span> ${inline(
            trimmed.replace("### ", "")
          )}</h3></div>`
        );
      } else if (trimmed.startsWith("## ")) {
        const text = trimmed.replace("## ", "").trim();
        const id = slugify(text);
        headings.push({ id, text });
        out.push(
          `<h2 id="${id}" class="group mt-16 mb-6 scroll-mt-24 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl border-l-4 border-indigo-600 pl-4 flex items-center justify-between"><a href="#${id}" class="hover:text-indigo-600 transition-colors">${inline(
            text
          )}</a><a href="#${id}" aria-label="Direct link to this section" class="text-sm font-bold text-indigo-600 opacity-0 transition-opacity group-hover:opacity-100">#</a></h2>`
        );
      } else if (trimmed.startsWith("Who should use it:")) {
        out.push(
          `<div class="my-6 rounded-2xl border border-emerald-200 bg-gradient-to-r from-emerald-50/90 to-teal-50/60 p-5 text-sm text-emerald-950 shadow-sm"><strong class="font-black text-emerald-800 flex items-center gap-2 mb-1 text-base"><span>✓</span> Who should use it:</strong> ${inline(
            trimmed.replace(/^Who should use it:\s*/i, "")
          )}</div>`
        );
      } else if (trimmed.startsWith("Who should skip it:")) {
        out.push(
          `<div class="my-6 rounded-2xl border border-rose-200 bg-gradient-to-r from-rose-50/90 to-orange-50/60 p-5 text-sm text-rose-950 shadow-sm"><strong class="font-black text-rose-800 flex items-center gap-2 mb-1 text-base"><span>✕</span> Who should skip it:</strong> ${inline(
            trimmed.replace(/^Who should skip it:\s*/i, "")
          )}</div>`
        );
      } else if (trimmed.startsWith("1. ") || trimmed.startsWith("2. ") || trimmed.startsWith("3. ") || trimmed.startsWith("4. ") || trimmed.startsWith("5. ")) {
        const num = trimmed.substring(0, 3);
        const rest = trimmed.substring(3);
        out.push(
          `<div class="my-4 rounded-2xl border border-slate-200/90 bg-white p-4.5 text-sm text-slate-800 shadow-sm hover:border-indigo-300 hover:shadow-md transition-all flex items-start gap-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-violet-600 text-xs font-black text-white shadow-sm">${num.replace('.', '').trim()}</span><div class="leading-relaxed font-medium">${inline(rest)}</div></div>`
        );
      } else if (trimmed) {
        out.push(`<p class="mt-5 text-[1.06rem] leading-8 text-slate-700 font-normal">${inline(trimmed)}</p>`);
      }
    });
    flushList();
  });
  flushList();

  return { html: out.join(""), headings };
};

const { html: bodyHtml, headings } = renderBody(post.body);

// TL;DR is the first section of the body when present; the rest are article sections.
const hasTldr = headings.length > 0 && headings[0].text === "TL;DR";
const articleHeadings = hasTldr ? headings.slice(1) : headings;

// Split body: TL;DR summary vs rest.
let tldrContent = "";
let restHtml = bodyHtml;
if (hasTldr) {
  const h2Tag = bodyHtml.match(/<h2 id="tl-dr"[^>]*>.*?<\/h2>/);
  const tldrH2Start = bodyHtml.indexOf('<h2 id="tl-dr"');
  const contentStart = tldrH2Start + (h2Tag ? h2Tag[0].length : 0);
  const boundary = articleHeadings.length
    ? bodyHtml.indexOf(`<h2 id="${articleHeadings[0].id}"`)
    : bodyHtml.length;
  const rawTldr = bodyHtml.slice(contentStart, boundary);
  const plugIdx = rawTldr.indexOf("ollawrite.com");
  const cutIdx =
    plugIdx > -1 ? rawTldr.indexOf("</p>", plugIdx) + "</p>".length : rawTldr.length;
  tldrContent = rawTldr.slice(0, cutIdx);
  restHtml = rawTldr.slice(cutIdx) + bodyHtml.slice(boundary);
}

// Exactly the Article Chapters in the TOC Sidebar
const toc = articleHeadings;

const isAiContentGenerator = post.slug === "ai-content-generator-complete-guide";
const isBestAiWritingTools = post.slug === "best-ai-writing-tools-in-2026";
const isWhatIsAiContentWriter = post.slug === "what-is-an-ai-content-writer";
const isAiAgentsVsAssistants = post.slug === "ai-agents-vs-ai-assistants";

const showQuickPicks = isAiContentGenerator || isBestAiWritingTools || isWhatIsAiContentWriter || isAiAgentsVsAssistants;

const quickPickConfig = isAiContentGenerator
  ? {
      title: "The 5 AI Content Generator Architectures — Comparison Matrix",
      badge: "5 Architectures",
      headers: ["Generator Category", "Core Mechanism", "Best Fit", "Interactive Action"],
      rows: [
        {
          c1: "General Reasoning Models",
          c2: "Next-token prediction + Instruction tuning (Claude, ChatGPT)",
          c3: "Versatile essays, outlining, reasoning & drafts",
          actionUrl: "#the-main-types-of-ai-content-generators-youll-actually-run-into",
          actionText: "Open Chapter →",
        },
        {
          c1: "Marketing Workflow Platforms",
          c2: "Prompt templates + Multi-channel governance (Jasper, Copy.ai)",
          c3: "High-volume ad copy, emails & campaign assets",
          actionUrl: "#the-main-types-of-ai-content-generators-youll-actually-run-into",
          actionText: "Open Chapter →",
        },
        {
          c1: "SEO-Native Ranking Platforms",
          c2: "Live SERP scraping + Search intent scoring (Surfer, Frase)",
          c3: "Competitive search ranking & content briefs",
          actionUrl: "#the-main-types-of-ai-content-generators-youll-actually-run-into",
          actionText: "Open Chapter →",
        },
        {
          c1: "Niche Creative Specialists",
          c2: "Genre heuristics + Narrative continuity (Sudowrite)",
          c3: "Fiction manuscripts, plotting & creative scenes",
          actionUrl: "#the-main-types-of-ai-content-generators-youll-actually-run-into",
          actionText: "Open Chapter →",
        },
        {
          c1: "Site-Grounded Multi-Agent",
          c2: "Live sitemap crawling + Critic verification (OllaWrite)",
          c3: "Verifiable, factual, site-anchored publishing",
          actionUrl: "#the-main-types-of-ai-content-generators-youll-actually-run-into",
          actionText: "Open Chapter →",
        },
      ],
    }
  : isBestAiWritingTools
  ? {
      title: "Quick Pick — The Shortlist",
      badge: "8 Tools",
      headers: ["Tool", "Best for", "Category / Focus", "Interactive Action"],
      rows: [
        { c1: "ChatGPT", c2: "Versatile research, outlining & drafting", c3: "General Model", actionUrl: "#chatgpt-still-the-default", actionText: "Open →" },
        { c1: "Claude", c2: "Natural long-form flow & nuanced tone", c3: "General Model", actionUrl: "#claude-natural-long-form-writing", actionText: "Open →" },
        { c1: "Google Gemini", c2: "Google Workspace & Docs integration", c3: "Ecosystem", actionUrl: "#google-gemini-best-for-google-workspace", actionText: "Open →" },
        { c1: "Writesonic", c2: "High-volume SEO content at scale", c3: "SEO Drafting", actionUrl: "#writesonic-seo-focused-content", actionText: "Open →" },
        { c1: "Grammarly", c2: "Real-time grammar, clarity & polish", c3: "Editing", actionUrl: "#grammarly-best-for-editing-and-polish", actionText: "Open →" },
        { c1: "Surfer SEO", c2: "SERP-driven on-page ranking scoring", c3: "SEO Ranking", actionUrl: "#surfer-seo-for-search-rankings", actionText: "Open →" },
        { c1: "Notion AI", c2: "Workspace-integrated drafting & notes", c3: "Productivity", actionUrl: "#notion-ai-writing-inside-your-workspace", actionText: "Open →" },
        { c1: "Sudowrite", c2: "Fiction, plot brainstorming & scenes", c3: "Creative", actionUrl: "#sudowrite-for-fiction-writers", actionText: "Open →" },
      ],
    }
  : isWhatIsAiContentWriter
  ? {
      title: "The 5 AI Content Writer Tiers — Architecture Matrix",
      badge: "5 Tiers",
      headers: ["Writer Category", "Core Engine", "Best Fit", "Interactive Action"],
      rows: [
        { c1: "Raw Prompt Generators", c2: "Direct LLM API without research or citation pass", c3: "Quick informal drafts & rough brainstorms", actionUrl: "#what-an-ai-content-writer-actually-is", actionText: "Open →" },
        { c1: "Template Marketing Tools", c2: "Multi-channel prompt templates & brand governance", c3: "Social ad copy, emails & campaign blurbs", actionUrl: "#what-an-ai-content-writer-actually-is", actionText: "Open →" },
        { c1: "SEO Scoring Platforms", c2: "Live SERP scraping & keyword density scoring", c3: "Search intent briefs & ranking optimization", actionUrl: "#what-an-ai-content-writer-actually-is", actionText: "Open →" },
        { c1: "Contextual Workspace Assistants", c2: "Document ingestion inside existing notes & CMS", c3: "Internal docs & meeting synthesis", actionUrl: "#what-an-ai-content-writer-actually-is", actionText: "Open →" },
        { c1: "Site-Grounded Multi-Agent", c2: "Autonomous crawler + factual critic gate", c3: "Verifiable, authoritative web publishing", actionUrl: "#what-an-ai-content-writer-actually-is", actionText: "Open →" },
      ],
    }
  : {
      title: "Architecture Matrix — The 4 Tiers",
      badge: "4 Tiers",
      headers: ["Architecture", "Best for", "Execution Model", "Interactive Action"],
      rows: [
        { c1: "AI Assistant", c2: "Conversational drafting, code review & legal redlines", c3: "Reactive / Chat", actionUrl: "#what-an-ai-content-writer-actually-is", actionText: "Open →" },
        { c1: "Contextual Assistant", c2: "Workspace document synthesis & file ingestion", c3: "Reactive / Workspace", actionUrl: "#what-an-ai-content-writer-actually-is", actionText: "Open →" },
        { c1: "Advisory Agent", c2: "24/7 background audit, pipeline & anomaly monitoring", c3: "Proactive / Scheduled", actionUrl: "#under-the-hood-the-5-step-pipeline", actionText: "Open →" },
        { c1: "Autonomous Agent", c2: "Multi-step tool execution with human approval gate", c3: "Proactive / Real Tools", actionUrl: "#under-the-hood-the-5-step-pipeline", actionText: "Open →" },
      ],
    };
---

<Layout title={`${post.title} — OllaWrite Journal`} description={post.excerpt}>
  <!-- Top Reading Progress Bar with Neon Glow -->
  <div
    id="reading-progress-bar"
    class="fixed top-0 left-0 h-1.5 bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-600 z-50 transition-all duration-75 shadow-[0_2px_12px_rgba(59,130,246,0.6)]"
    style="width: 0%;"
  ></div>

  <!-- Toast notification for link copy -->
  <div
    id="copy-toast"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transform opacity-0 pointer-events-none transition-all duration-300 rounded-full border border-slate-800 bg-slate-950/95 backdrop-blur-md px-5 py-2.5 text-xs font-semibold text-white shadow-2xl flex items-center gap-2"
  >
    <span class="text-emerald-400 font-black">✓</span> Copied link to clipboard
  </div>

  <article class="bg-[#ffffff] text-slate-900 min-h-screen">
    <!-- Top sticky bar -->
    <div class="border-b border-slate-200/80 bg-white/90 backdrop-blur-md sticky top-16 z-30 shadow-sm">
      <div class="wrap flex items-center justify-between py-3.5">
        <a
          href="/blog"
          class="flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-indigo-600 transition-colors"
        >
          ← Back to Journal
        </a>
        <a
          href="#table-of-contents-top"
          class="flex items-center gap-1.5 text-xs font-bold text-indigo-600 hover:text-indigo-800 transition-colors"
        >
          Skip to Table of Contents ↓
        </a>
      </div>
    </div>

    <!-- Hero Header with Ambient Background Glow -->
    <div class="relative border-b border-slate-200/80 bg-gradient-to-b from-slate-50 via-indigo-50/30 to-white overflow-hidden">
      <!-- Decorative ambient gradient circles -->
      <div class="pointer-events-none absolute -top-24 right-1/4 h-96 w-96 rounded-full bg-blue-400/10 blur-3xl"></div>
      <div class="pointer-events-none absolute top-10 left-10 h-72 w-72 rounded-full bg-indigo-500/10 blur-2xl"></div>

      <div class="wrap relative py-12 lg:py-16">
        <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-widest text-indigo-600">
          <span class="rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 px-3.5 py-1 text-white shadow-sm font-black">
            {post.category}
          </span>
          <span class="text-slate-300">•</span>
          <span class="text-slate-600 font-bold">{post.date}</span>
          <span class="text-slate-300">•</span>
          <span class="text-slate-600 font-bold">{post.readTime}</span>
        </div>
        <h1
          class="mt-5 max-w-4xl text-3xl font-black leading-[1.12] tracking-tight sm:text-4xl lg:text-[3.25rem] text-slate-900"
        >
          {post.title}
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-600 font-normal">
          {post.excerpt}
        </p>
        <div class="mt-6 flex items-center gap-3 text-sm text-slate-500">
          <span class="grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-violet-600 text-sm font-black text-white shadow-md ring-2 ring-indigo-100">OW</span>
          <div>
            <p class="font-black text-slate-900">{post.author.name}</p>
            <p class="text-xs text-slate-500 font-semibold">{post.author.role}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Body: sticky TOC sidebar + full-width content -->
    <div class="wrap py-12 lg:py-16">
      <div class="lg:flex lg:gap-10">
        <!-- VIBRANT ELECTRIC GRADIENT TOC SIDEBAR WITH CHAPTERS -->
        <aside class="mb-10 lg:mb-0 lg:w-76 lg:shrink-0">
          <nav class="rounded-2xl border-2 border-indigo-100 bg-white p-4 shadow-[0_12px_36px_rgba(79,70,229,0.08)] lg:sticky lg:top-28">
            <!-- Sidebar Header Banner with Electric Gradient -->
            <div class="flex items-center justify-between rounded-xl bg-gradient-to-r from-blue-600 via-indigo-600 to-violet-600 px-4 py-3 text-white shadow-md">
              <h2 class="flex items-center gap-2 text-xs font-black uppercase tracking-wider text-white">
                <span class="text-cyan-200">☰</span> Table of Contents
              </h2>
              <span class="rounded-full bg-white/20 backdrop-blur-md px-2.5 py-0.5 text-[0.65rem] font-black text-white border border-white/30 shadow-sm">
                {toc.length} Chapters
              </span>
            </div>

            <!-- Quick jump pill inside sidebar for TL;DR -->
            {
              hasTldr && (
                <div class="mt-3 border-b border-slate-100 pb-2.5">
                  <a
                    href="#tl-dr"
                    class="group flex items-center justify-between rounded-xl bg-gradient-to-r from-indigo-50 via-purple-50 to-blue-50 border border-indigo-200 px-3 py-2 text-xs font-bold text-indigo-700 transition-all hover:border-indigo-400 hover:shadow-sm"
                  >
                    <span class="flex items-center gap-1.5">
                      <span class="text-indigo-600">⚡</span> 30-Sec TL;DR
                    </span>
                    <span class="text-[0.65rem] font-black text-indigo-600 group-hover:text-indigo-800">Jump ↓</span>
                  </a>
                </div>
              )
            }

            <ol id="sidebar-toc" class="mt-3 space-y-1.5 max-h-[62vh] overflow-y-auto pr-1 toc-scrollbar">
              {
                toc.map((h, i) => (
                  <li>
                    <a
                      href={`#${h.id}`}
                      data-target={h.id}
                      class="toc-sidebar-link group flex items-center gap-2.5 rounded-xl border border-slate-200/80 bg-white px-2.5 py-2 text-xs font-semibold text-slate-800 transition-all hover:border-indigo-500 hover:bg-gradient-to-r hover:from-blue-50/60 hover:to-indigo-50/60 hover:text-indigo-700 hover:shadow-sm"
                    >
                      <span class="toc-badge flex h-5 w-5 shrink-0 items-center justify-center rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-600 text-[0.65rem] font-black text-white shadow-sm transition-transform group-hover:scale-105">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <span class="flex-1 truncate leading-tight font-semibold">{h.text}</span>
                      <span class="text-slate-300 transition-transform group-hover:translate-x-0.5 group-hover:text-indigo-600 text-[0.7rem] font-black">→</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </aside>

        <!-- Article content -->
        <div class="min-w-0 flex-1 lg:max-w-[56rem]">
          <!-- 1. TABLE OF CONTENTS: CHAPTER MODULES (TOP) -->
          <section id="table-of-contents-top" class="mb-8 scroll-mt-32">
            <!-- Modern High-Contrast White Chapter Grid with Vibrant Badges -->
            <div class="overflow-hidden rounded-2xl border-2 border-indigo-100 bg-white p-6 shadow-[0_12px_36px_rgba(79,70,229,0.06)]">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div class="flex items-center gap-2.5">
                  <span class="grid h-8 w-8 place-items-center rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-xs font-black text-white shadow-md">☰</span>
                  <h3 class="text-sm font-black uppercase tracking-wider text-slate-900">
                    Table of Contents — Chapter Modules
                  </h3>
                </div>
                <span class="rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 px-3.5 py-1 text-xs font-black text-white shadow-sm">
                  {articleHeadings.length} Chapters
                </span>
              </div>
              <div class="mt-5 grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
                {
                  articleHeadings.map((h, i) => (
                    <a
                      href={`#${h.id}`}
                      class="group relative flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-4.5 shadow-sm transition-all duration-200 hover:-translate-y-1.5 hover:border-indigo-500 hover:bg-gradient-to-br hover:from-white hover:to-indigo-50/40 hover:shadow-lg"
                    >
                      <div class="flex items-center justify-between">
                        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-violet-600 text-xs font-black text-white shadow-sm transition-transform group-hover:scale-110">
                          {String(i + 1).padStart(2, "0")}
                        </span>
                        <span class="text-xs font-black text-indigo-600 bg-indigo-50 border border-indigo-100 px-2.5 py-0.5 rounded-lg group-hover:bg-indigo-600 group-hover:text-white transition-all">
                          Open →
                        </span>
                      </div>
                      <span class="mt-3.5 text-xs font-bold text-slate-900 leading-snug transition-colors group-hover:text-indigo-600">
                        {h.text}
                      </span>
                    </a>
                  ))
                }
              </div>
            </div>
          </section>

          <!-- 2. TL;DR SUMMARY (BEFORE THE MATRIX TABLE) -->
          {
            hasTldr && (
              <section id="tl-dr" class="relative mb-8 scroll-mt-32 overflow-hidden rounded-2xl border-2 border-indigo-950 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white shadow-[0_16px_40px_rgba(15,23,42,0.25)]">
                <div class="h-1.5 bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-600"></div>
                <div class="p-6 sm:p-8">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="rounded-xl border border-indigo-400/40 bg-gradient-to-r from-blue-600/40 to-indigo-600/40 px-3.5 py-1 text-xs font-black uppercase tracking-wider text-cyan-300 shadow-sm backdrop-blur-sm">
                      TL;DR
                    </span>
                    <span class="text-xs font-bold uppercase tracking-wider text-indigo-200">
                      Too long? Here's the whole article in 30 seconds
                    </span>
                  </div>
                  <div class="mt-4 border-l-4 border-indigo-400 pl-5 tldr-body" set:html={tldrContent} />
                </div>
              </section>
            )
          }

          <!-- 3. COMPARISON MATRIX TABLE (AFTER TL;DR) -->
          {
            showQuickPicks && (
              <section class="mb-10 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_10px_30px_rgba(79,70,229,0.06)]">
                <div class="flex items-center justify-between bg-gradient-to-r from-slate-950 via-indigo-950 to-slate-900 px-6 py-4 border-b border-indigo-900/40">
                  <h3 class="text-sm font-black uppercase tracking-wider text-cyan-300 flex items-center gap-2">
                    <span class="text-amber-400">⚡</span> {quickPickConfig.title}
                  </h3>
                  <span class="rounded-full bg-white/10 border border-white/20 px-3 py-0.5 text-[0.65rem] font-black uppercase tracking-wider text-slate-200">
                    {quickPickConfig.badge}
                  </span>
                </div>
                <div class="overflow-x-auto">
                  <table class="w-full min-w-[34rem] text-left text-sm">
                    <thead>
                      <tr class="border-b border-slate-200 bg-slate-50 text-xs font-black uppercase tracking-wider text-slate-700">
                        <th class="px-6 py-3.5">{quickPickConfig.headers[0]}</th>
                        <th class="px-6 py-3.5">{quickPickConfig.headers[1]}</th>
                        <th class="px-6 py-3.5">{quickPickConfig.headers[2]}</th>
                        <th class="px-6 py-3.5 text-right">{quickPickConfig.headers[3]}</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      {
                        quickPickConfig.rows.map((row, i) => (
                          <tr class={`transition-colors hover:bg-indigo-50/50 ${i % 2 === 0 ? "bg-white" : "bg-slate-50/60"}`}>
                            <td class="px-6 py-4 font-black text-slate-900">{row.c1}</td>
                            <td class="px-6 py-4 text-slate-600 text-xs leading-relaxed">{row.c2}</td>
                            <td class="px-6 py-4 font-bold text-indigo-600 text-xs">{row.c3}</td>
                            <td class="px-6 py-4 text-right">
                              <a
                                href={row.actionUrl}
                                class="inline-flex items-center gap-1 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-3.5 py-1.5 text-xs font-black text-white shadow-sm transition-all hover:shadow-md hover:scale-105"
                              >
                                {row.actionText}
                              </a>
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
              </section>
            )
          }

          <!-- 4. REMAINING CONTENT DIRECTLY -->
          <div set:html={restHtml} />

          <!-- Bottom quick action bar: direct link to TOC & TL;DR -->
          <div class="mt-12 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_10px_30px_rgba(79,70,229,0.05)]">
            <div class="flex items-center gap-3 text-sm font-semibold text-slate-700">
              <span class="grid h-8 w-8 place-items-center rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-xs font-black text-white shadow-sm">⚡</span>
              <span>Finished reading? Need to review chapters or summary?</span>
            </div>
            <div class="flex items-center gap-3">
              <a
                href="#table-of-contents-top"
                class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2 text-xs font-bold text-slate-700 transition-all hover:border-indigo-400 hover:text-indigo-700 hover:bg-white shadow-sm"
              >
                ↑ Table of Contents
              </a>
              {
                hasTldr && (
                  <a
                    href="#tl-dr"
                    class="inline-flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-2 text-xs font-black uppercase tracking-wider text-white shadow-sm transition-all hover:scale-105 hover:shadow-md"
                  >
                    ↑ 30-sec TL;DR
                  </a>
                )
              }
              <a
                href="https://login.ollawrite.com"
                class="inline-flex items-center gap-1.5 rounded-xl border border-slate-900 bg-slate-900 px-4 py-2 text-xs font-black uppercase tracking-wider text-white transition-all hover:bg-slate-800 shadow-sm"
              >
                Audit your site free →
              </a>
            </div>
          </div>

          <!-- Floating Action Control Pill (White contrast aesthetic) -->
          <div class="fixed bottom-6 right-6 z-40 flex items-center gap-2 rounded-full border border-slate-300 bg-white/95 p-1.5 shadow-[0_12px_36px_rgba(0,0,0,0.12)] backdrop-blur-md">
            <a
              href="#main"
              title="Back to Top"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-xs font-black text-slate-700 transition-colors hover:bg-gradient-to-r hover:from-blue-600 hover:to-indigo-600 hover:text-white"
            >
              ↑
            </a>
            {
              hasTldr && (
                <a
                  href="#tl-dr"
                  title="Jump to TL;DR"
                  class="flex h-9 px-3.5 items-center justify-center rounded-full bg-gradient-to-r from-blue-50 to-indigo-50 border border-indigo-200 text-xs font-black text-indigo-700 transition-all hover:bg-gradient-to-r hover:from-blue-600 hover:to-indigo-600 hover:text-white"
                >
                  ⚡ TL;DR
                </a>
              )
            }
            <button
              id="copy-article-link"
              type="button"
              title="Copy link to clipboard"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-700 transition-colors hover:bg-gradient-to-r hover:from-blue-600 hover:to-indigo-600 hover:text-white"
            >
              🔗
            </button>
          </div>

          <!-- Email signup (Clean pleasant contrast) -->
          <div class="mt-10 overflow-hidden rounded-2xl border border-slate-900/10 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 p-6 text-white shadow-xl">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-[0.7rem] font-black uppercase tracking-widest text-cyan-300">
                  The OllaWrite Journal
                </p>
                <h3 class="mt-1 text-base font-bold text-white sm:text-lg">
                  Get weekly AI writing deep-dives in your inbox
                </h3>
              </div>
              <form
                action="https://login.ollawrite.com/register"
                method="get"
                class="flex items-center gap-2"
              >
                <label for="journal-email" class="sr-only">Email address</label>
                <input
                  id="journal-email"
                  type="email"
                  name="email"
                  required
                  placeholder="you@company.com"
                  class="w-48 sm:w-56 rounded-xl border border-white/20 bg-white/10 px-3.5 py-2.5 text-xs text-white placeholder-indigo-200/70 outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 backdrop-blur-sm"
                />
                <button
                  type="submit"
                  class="whitespace-nowrap rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-2.5 text-xs font-bold text-white transition-all hover:scale-105 shadow-sm"
                >
                  Sign up →
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Script for Reading Progress Bar, Scroll Spy, & Copy Actions -->
  <script>
    // 1. Reading progress bar
    const progressBar = document.getElementById("reading-progress-bar");
    const updateProgress = () => {
      const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollTotal > 0 && progressBar) {
        const scrolled = (window.scrollY / scrollTotal) * 100;
        progressBar.style.width = Math.min(100, Math.max(0, scrolled)) + "%";
      }
    };
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();

    // 2. Active Sidebar TOC Spy
    const headings = document.querySelectorAll("article h2[id]");
    const tocLinks = document.querySelectorAll(".toc-sidebar-link");

    const highlightToc = () => {
      let currentId = "";
      const scrollPos = window.scrollY + 160;

      headings.forEach((heading) => {
        const top = (heading as HTMLElement).offsetTop;
        if (scrollPos >= top) {
          currentId = heading.id;
        }
      });

      tocLinks.forEach((link) => {
        const target = link.getAttribute("data-target");
        const badge = link.querySelector(".toc-badge");
        if (target === currentId) {
          link.classList.add("border-indigo-600", "bg-indigo-50/90", "text-indigo-950", "font-bold", "shadow-sm");
          link.classList.remove("border-slate-200/80", "bg-white", "text-slate-800");
          badge?.classList.add("scale-110", "ring-2", "ring-indigo-300");
        } else {
          link.classList.remove("border-indigo-600", "bg-indigo-50/90", "text-indigo-950", "font-bold", "shadow-sm");
          link.classList.add("border-slate-200/80", "bg-white", "text-slate-800");
          badge?.classList.remove("scale-110", "ring-2", "ring-indigo-300");
        }
      });
    };
    window.addEventListener("scroll", highlightToc, { passive: true });
    highlightToc();

    // 3. One-Click Copy Article URL Toast
    const copyBtn = document.getElementById("copy-article-link");
    const toast = document.getElementById("copy-toast");
    copyBtn?.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        if (toast) {
          toast.classList.remove("opacity-0", "pointer-events-none");
          toast.classList.add("opacity-100");
          setTimeout(() => {
            toast.classList.remove("opacity-100");
            toast.classList.add("opacity-0", "pointer-events-none");
          }, 2500);
        }
      });
    });
  </script>
</Layout>

