---
import Layout from "../../layouts/Layout.astro";
import { BLOG_POSTS } from "../../data/blog";

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const slugify = (s: string): string =>
  s
    .toLowerCase()
    .replace(/['"“”‘’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

// Render markdown body with well-defined black border boxes for points & red highlighted mistake boxes
const renderBody = (body: string) => {
  const escape = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  const inline = (s: string) =>
    escape(s)
      .replace(
        /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener noreferrer" class="font-bold text-blue-600 underline underline-offset-4 hover:text-blue-800 transition-colors">$1</a>'
      )
      .replace(/\*\*([^\*]+)\*\*/g, '<strong class="font-bold text-slate-900">$1</strong>')
      .replace(/\*([^\*]+)\*/g, '<em class="text-slate-800 font-medium italic">$1</em>');

  const out: string[] = [];
  const headings: { id: string; text: string }[] = [];
  let list: string[] = [];
  let orderedList: string[] = [];

  let inMistakes = false;
  let mistakesList: string[] = [];

  const flushMistakes = () => {
    if (inMistakes && mistakesList.length > 0) {
      out.push(`<ul class="my-6 space-y-4 list-none p-0">${mistakesList.join("")}</ul>`);
      mistakesList = [];
      inMistakes = false;
    }
  };

  const flushList = () => {
    if (inMistakes) {
      flushMistakes();
      return;
    }
    if (list.length > 0) {
      out.push(`<ul class="my-6 space-y-3.5 list-none p-0">${list.join("")}</ul>`);
      list = [];
    }
    if (orderedList.length > 0) {
      out.push(`<ol class="my-6 space-y-3.5 list-none p-0">${orderedList.join("")}</ol>`);
      orderedList = [];
    }
  };

  let inFaq = false;
  let faqItems: { q: string; a: string[] }[] = [];
  let currentFaq: { q: string; a: string[] } | null = null;

  let inWrappingUp = false;
  let wrappingUpParagraphs: string[] = [];

  let inKeyPoints = false;
  let keyPointsList: string[] = [];
  let keyPointsHtml = "";

  const flushKeyPoints = () => {
    if (inKeyPoints && keyPointsList.length > 0) {
      keyPointsHtml = `
        <section id="key-takeaways" class="my-8 scroll-mt-28 rounded-2xl border-2 border-slate-900 bg-[#f8fafc] p-6 sm:p-8 text-slate-900 shadow-md">
          <h3 class="text-xl font-black text-blue-600 mb-6 flex items-center gap-2">
            Key Takeaways
          </h3>
          <ul class="space-y-4 list-none p-0 m-0">
            ${keyPointsList.join("")}
          </ul>
        </section>
      `;
      keyPointsList = [];
      inKeyPoints = false;
    }
  };

  let faqHtml = "";
  const flushFaq = () => {
    if (currentFaq) {
      faqItems.push(currentFaq);
      currentFaq = null;
    }
    if (faqItems.length > 0) {
      const itemsHtml = faqItems
        .map(
          (item) => `
        <details class="faq-item group border-2 border-slate-900 rounded-xl bg-white p-5 transition-all hover:border-blue-600 open:border-blue-600 open:bg-blue-50/20 shadow-sm">
          <summary class="flex cursor-pointer list-none items-center justify-between font-bold text-slate-900 hover:text-blue-700 transition-colors">
            <span class="text-base sm:text-lg pr-4 font-bold">${inline(item.q)}</span>
            <span class="faq-toggle-badge inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-50 border border-blue-200 text-blue-600 font-bold transition-transform group-open:bg-blue-600 group-open:text-white">
              <span class="group-open:hidden text-lg">+</span>
              <span class="hidden group-open:inline text-lg">−</span>
            </span>
          </summary>
          <div class="mt-4 pt-3 border-t border-slate-200 space-y-3 text-slate-600 leading-relaxed text-[1.02rem] font-normal">
            ${item.a.map((p) => `<p>${inline(p)}</p>`).join("")}
          </div>
        </details>`
        )
        .join("");

      faqHtml = `
        <section id="faq" class="my-10 scroll-mt-28">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mb-6 border-l-4 border-blue-600 pl-4">
            Frequently Asked Questions
          </h2>
          <div class="space-y-4">
            ${itemsHtml}
          </div>
        </section>
      `;
    }
  };

  let wrappingUpHtml = "";
  const flushWrappingUp = () => {
    if (wrappingUpParagraphs.length > 0) {
      wrappingUpHtml = `
        <section id="wrapping-it-up" class="my-10 scroll-mt-28 rounded-2xl border-2 border-slate-900 bg-gradient-to-br from-blue-50/70 via-sky-50/50 to-blue-50/70 p-8 sm:p-10 text-center shadow-md">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mb-4">Wrapping It Up</h2>
          <div class="space-y-4 max-w-3xl mx-auto text-slate-700 text-[1.08rem] leading-relaxed mb-8">
            ${wrappingUpParagraphs.map((p) => `<p>${inline(p)}</p>`).join("")}
          </div>
          <div class="flex justify-center">
            <a href="https://www.ollawrite.com" class="inline-flex items-center justify-center font-bold px-8 py-4 text-base rounded-xl bg-blue-600 text-white hover:bg-blue-700 shadow-lg shadow-blue-500/30 transition-all hover:scale-105">
              Start free with OllaWrite →
            </a>
          </div>
        </section>
      `;
    }
  };

  const blocks = body.split("\n\n");
  blocks.forEach((block) => {
    const lines = block.split("\n");
    lines.forEach((line) => {
      const trimmed = line.trim();

      if (trimmed.startsWith("## Frequently Asked Questions")) {
        flushList();
        if (inWrappingUp) flushWrappingUp();
        if (inKeyPoints) flushKeyPoints();
        inFaq = true;
        headings.push({ id: "faq", text: "Frequently Asked Questions" });
        return;
      }

      if (
        trimmed.startsWith("## Wrapping Up") ||
        trimmed.startsWith("## Final Verdict") ||
        trimmed.startsWith("## Final Thoughts")
      ) {
        flushList();
        if (inFaq) flushFaq();
        if (inKeyPoints) flushKeyPoints();
        inWrappingUp = true;
        headings.push({ id: "wrapping-it-up", text: "Wrapping It Up" });
        return;
      }

      if (trimmed.startsWith("## Key Points") || trimmed.startsWith("## Key Takeaways")) {
        flushList();
        if (inFaq) flushFaq();
        if (inWrappingUp) flushWrappingUp();
        inKeyPoints = true;
        headings.push({ id: "key-takeaways", text: "Key Takeaways" });
        return;
      }

      if (
        trimmed.toLowerCase().includes("mistake") &&
        trimmed.startsWith("## ")
      ) {
        flushList();
        if (inFaq) flushFaq();
        if (inWrappingUp) flushWrappingUp();
        if (inKeyPoints) flushKeyPoints();
        inMistakes = true;
        const text = trimmed.replace("## ", "").trim();
        const id = slugify(text);
        headings.push({ id, text });
        out.push(
          `<h2 id="${id}" class="text-2xl sm:text-3xl font-black text-slate-900 mt-12 mb-6 scroll-mt-28 border-l-4 border-red-600 pl-4"><a href="#${id}" class="hover:text-red-600 transition-colors">${inline(text)}</a></h2>`
        );
        return;
      }

      if (inKeyPoints) {
        if (trimmed.startsWith("- ")) {
          const text = trimmed.replace(/^-\s*/, "");
          keyPointsList.push(
            `<li class="rounded-xl border-2 border-slate-900 bg-white p-4 sm:p-5 shadow-xs flex gap-3.5 items-start"><span class="text-blue-600 font-black text-xl leading-none flex-shrink-0 mt-0.5">•</span><div class="text-slate-800 text-[1.02rem] leading-relaxed">${inline(text)}</div></li>`
          );
          return;
        } else if (trimmed.startsWith("## ")) {
          flushKeyPoints();
        } else if (trimmed) {
          flushKeyPoints();
        }
      }

      if (inMistakes) {
        if (trimmed.startsWith("- ")) {
          const rawItem = trimmed.replace(/^-\s*/, "");
          // Check for bold title format: **Mistake X: Title**: Description
          const boldMatch = rawItem.match(/^\*\*(.*?)\*\*:\s*(.*)$/);
          if (boldMatch) {
            const mTitle = boldMatch[1];
            const mDesc = boldMatch[2];
            mistakesList.push(
              `<li class="rounded-xl border-2 border-slate-900 bg-red-50/30 p-5 sm:p-6 shadow-sm transition-all hover:border-red-600 flex flex-col gap-2.5">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600 font-black text-xs">✕</span>
                  <span class="text-red-600 font-black text-base sm:text-lg tracking-tight">${inline(mTitle)}</span>
                </div>
                <p class="text-slate-700 text-[1.02rem] leading-relaxed pl-8 m-0 font-normal">${inline(mDesc)}</p>
              </li>`
            );
          } else {
            mistakesList.push(
              `<li class="rounded-xl border-2 border-slate-900 bg-red-50/30 p-5 sm:p-6 shadow-sm flex gap-3.5 items-start">
                <span class="text-red-600 font-black text-xl leading-none flex-shrink-0 mt-0.5">•</span>
                <div class="text-slate-700 text-[1.02rem] leading-relaxed">${inline(rawItem)}</div>
              </li>`
            );
          }
          return;
        } else if (trimmed.startsWith("## ")) {
          flushMistakes();
        }
      }

      if (inFaq) {
        if (trimmed.startsWith("### ")) {
          if (currentFaq) faqItems.push(currentFaq);
          currentFaq = { q: trimmed.replace("### ", "").trim(), a: [] };
          return;
        }
        if (trimmed.startsWith("## ")) {
          flushFaq();
        } else if (currentFaq && trimmed) {
          currentFaq.a.push(trimmed);
          return;
        }
      }

      if (inWrappingUp) {
        if (trimmed.startsWith("## ")) {
          flushWrappingUp();
        } else if (trimmed) {
          wrappingUpParagraphs.push(trimmed);
          return;
        }
      }

      if (trimmed.startsWith("- ")) {
        const text = trimmed.replace(/^-\s*/, "");
        list.push(
          `<li class="rounded-xl border-2 border-slate-900 bg-white p-4 sm:p-4.5 shadow-xs flex gap-3.5 items-start"><span class="text-blue-600 font-black text-lg leading-none flex-shrink-0 mt-0.5">•</span><span class="text-slate-700 text-[1.02rem] leading-relaxed font-normal">${inline(text)}</span></li>`
        );
        return;
      }

      if (/^\d+\.\s/.test(trimmed)) {
        const text = trimmed.replace(/^\d+\.\s*/, "");
        orderedList.push(
          `<li class="rounded-xl border-2 border-slate-900 bg-white p-4 sm:p-4.5 shadow-xs flex gap-3.5 items-start"><span class="font-black text-blue-600 text-[1.02rem] flex-shrink-0">${orderedList.length + 1}.</span><span class="text-slate-700 text-[1.02rem] leading-relaxed font-normal">${inline(text)}</span></li>`
        );
        return;
      }

      flushList();

      if (trimmed.startsWith("### ")) {
        const text = trimmed.replace("### ", "").trim();
        const id = slugify(text);
        out.push(
          `<h3 id="${id}" class="text-xl sm:text-2xl font-black text-slate-900 mt-8 mb-4 scroll-mt-28"><a href="#${id}" class="hover:text-blue-600 transition-colors">${inline(text)}</a></h3>`
        );
      } else if (trimmed.startsWith("## ")) {
        const text = trimmed.replace("## ", "").trim();
        const id = slugify(text);
        headings.push({ id, text });
        out.push(
          `<h2 id="${id}" class="text-2xl sm:text-3xl font-black text-slate-900 mt-12 mb-6 scroll-mt-28 border-l-4 border-blue-600 pl-4"><a href="#${id}" class="hover:text-blue-600 transition-colors">${inline(text)}</a></h2>`
        );
      } else if (trimmed) {
        out.push(
          `<p class="text-slate-700 text-[1.12rem] leading-relaxed mb-6 font-normal">${inline(trimmed)}</p>`
        );
      }
    });
  });

  flushList();
  if (inFaq) flushFaq();
  if (inWrappingUp) flushWrappingUp();
  flushKeyPoints();

  return { html: out.join(""), faqHtml, wrappingUpHtml, keyPointsHtml, headings };
};

const { html: bodyHtml, faqHtml, wrappingUpHtml, keyPointsHtml, headings } = renderBody(post.body);

// TL;DR extraction
const hasTldr = headings.length > 0 && headings[0].text === "TL;DR";
const articleHeadings = headings.filter(h => h.text !== "TL;DR" && h.text !== "Key Takeaways" && h.text !== "Key Points");

let tldrContent = "";
let restHtml = bodyHtml;
if (hasTldr) {
  const h2Tag = bodyHtml.match(/<h2 id="tl-dr"[^>]*>.*?<\/h2>/);
  const tldrH2Start = bodyHtml.indexOf('<h2 id="tl-dr"');
  const contentStart = tldrH2Start + (h2Tag ? h2Tag[0].length : 0);
  const boundary = articleHeadings.length
    ? bodyHtml.indexOf(`<h2 id="${articleHeadings[0].id}"`)
    : bodyHtml.length;
  const rawTldr = bodyHtml.slice(contentStart, boundary);
  const plugIdx = rawTldr.indexOf("ollawrite.com");
  const cutIdx =
    plugIdx > -1 ? rawTldr.indexOf("</p>", plugIdx) + "</p>".length : rawTldr.length;
  tldrContent = rawTldr.slice(0, cutIdx);
  restHtml = bodyHtml.slice(boundary);
}

// Exactly the chapters for the sidebar TOC
const tocItems = [
  ...(hasTldr ? [{ id: "tldr", text: "TL;DR Summary" }] : []),
  ...(keyPointsHtml ? [{ id: "key-takeaways", text: "Key Takeaways" }] : []),
  ...articleHeadings.map((h) => ({ id: h.id, text: h.text })),
  ...(faqHtml ? [{ id: "faq", text: "Frequently Asked Questions" }] : []),
  ...(wrappingUpHtml ? [{ id: "wrapping-it-up", text: "Wrapping It Up" }] : []),
];
---

<Layout title={`${post.title} — OllaWrite`} description={post.excerpt}>
  <!-- Top Reading Progress Bar -->
  <div id="reading-progress-container" class="fixed top-0 left-0 z-50 h-1.5 w-full bg-slate-200">
    <div id="reading-progress-bar" class="h-full bg-blue-600 w-0 transition-all duration-75"></div>
  </div>

  <div class="max-w-[1360px] mx-auto px-6 py-12 lg:py-16">
    <article class="w-full">
      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-slate-200">
        <div class="flex items-center gap-3 text-xs sm:text-sm font-bold text-blue-600 uppercase tracking-wider mb-4">
          <span>{post.category}</span>
          <span>•</span>
          <span>{post.date}</span>
          <span>•</span>
          <span>{post.readTime}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 leading-tight mb-6">
          {post.title}
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-4xl">
          {post.excerpt}
        </p>
      </header>

      <!-- 2-Column Grid Layout: Sticky TOC + Content -->
      <div class="flex flex-col lg:flex-row gap-10 items-start relative w-full">
        <!-- Sticky Sidebar TOC -->
        <aside class="w-full lg:w-[320px] lg:shrink-0 lg:sticky lg:top-24 max-h-[calc(100vh-120px)] overflow-y-auto">
          <div class="rounded-2xl border-2 border-slate-900 bg-white p-5 shadow-sm">
            <div class="flex items-center gap-2 pb-3 mb-3 border-b border-slate-100 font-black text-slate-900 text-sm uppercase tracking-wider">
              <span class="text-blue-600">☰</span>
              <span>Table of Contents</span>
            </div>
            <nav class="space-y-1.5">
              {
                tocItems.map((item, index) => (
                  <a
                    href={`#${item.id}`}
                    data-target={item.id}
                    class="toc-sidebar-link flex items-center gap-2.5 rounded-xl border border-transparent px-3 py-2 text-xs font-semibold text-slate-600 transition-all hover:border-slate-300 hover:bg-blue-50/70 hover:text-blue-700"
                  >
                    <span class="toc-num flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-blue-100 text-[0.7rem] font-bold text-blue-700">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="flex-1 truncate">{item.text}</span>
                  </a>
                ))
              }
            </nav>
          </div>
        </aside>

        <!-- Main Content Column -->
        <div class="flex-1 min-w-0 w-full">
          <!-- 1. TL;DR Highlight Box -->
          {
            hasTldr && (
              <section id="tldr" class="mb-8 scroll-mt-28 rounded-2xl border-2 border-slate-900 border-l-8 border-l-blue-600 bg-blue-50/50 p-6 sm:p-8 text-slate-900 shadow-sm">
                <h3 class="text-xl font-black text-blue-700 mb-3">TL;DR</h3>
                <div class="text-[1.08rem] leading-relaxed text-slate-700 space-y-3" set:html={tldrContent} />
              </section>
            )
          }

          <!-- 2. Key Takeaways Box -->
          {keyPointsHtml && <div set:html={keyPointsHtml} />}

          <!-- 3. Core Article Content Box -->
          <div class="my-8 rounded-3xl border-2 border-slate-900 bg-white p-6 sm:p-10 shadow-sm">
            <div set:html={restHtml} />
          </div>

          <!-- 4. Standalone FAQ Section -->
          {faqHtml && <div set:html={faqHtml} />}

          <!-- 5. Standalone Wrapping Up Box -->
          {wrappingUpHtml && <div set:html={wrappingUpHtml} />}

          <!-- Floating Back-to-Top & Copy Pill -->
          <div class="fixed bottom-6 right-6 z-40 flex items-center gap-2 rounded-full border-2 border-slate-900 bg-white/95 p-1.5 shadow-lg backdrop-blur-md">
            <a
              href="#"
              title="Back to Top"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-xs font-black text-slate-700 hover:bg-blue-600 hover:text-white transition-colors"
            >
              ↑
            </a>
            <button
              id="copy-article-link"
              type="button"
              title="Copy link to clipboard"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-700 hover:bg-blue-600 hover:text-white transition-colors"
            >
              🔗
            </button>
          </div>
        </div>
      </div>
    </article>
  </div>

  <!-- Toast for Copy Link -->
  <div
    id="copy-toast"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transform opacity-0 pointer-events-none transition-all duration-300 rounded-full border border-slate-800 bg-slate-950/95 backdrop-blur-md px-5 py-2.5 text-xs font-semibold text-white shadow-2xl flex items-center gap-2"
  >
    <span class="text-emerald-400 font-black">✓</span> Copied link to clipboard
  </div>

  <script>
    // 1. Reading progress bar
    const bar = document.getElementById("reading-progress-bar");
    const updateProgress = () => {
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollHeight > 0 && bar) {
        const pct = (window.scrollY / scrollHeight) * 100;
        bar.style.width = Math.min(100, Math.max(0, pct)) + "%";
      }
    };
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();

    // 2. Active TOC Scroll Spy
    const headings = document.querySelectorAll("article h2[id], article h3[id], section[id]");
    const tocLinks = document.querySelectorAll(".toc-sidebar-link");

    const updateActiveToc = () => {
      let currentId = "";
      const scrollPos = window.scrollY + 160;

      headings.forEach((heading) => {
        const top = (heading as HTMLElement).offsetTop;
        if (scrollPos >= top) {
          currentId = heading.id;
        }
      });

      tocLinks.forEach((link) => {
        const target = link.getAttribute("data-target");
        if (target === currentId) {
          link.classList.add("border-blue-500", "bg-blue-50", "text-blue-700", "font-bold");
          link.classList.remove("border-transparent", "text-slate-600");
        } else {
          link.classList.remove("border-blue-500", "bg-blue-50", "text-blue-700", "font-bold");
          link.classList.add("border-transparent", "text-slate-600");
        }
      });
    };
    window.addEventListener("scroll", updateActiveToc, { passive: true });
    updateActiveToc();

    // 3. Copy Link Toast
    const copyBtn = document.getElementById("copy-article-link");
    const toast = document.getElementById("copy-toast");
    copyBtn?.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        if (toast) {
          toast.classList.remove("opacity-0", "pointer-events-none");
          toast.classList.add("opacity-100");
          setTimeout(() => {
            toast.classList.remove("opacity-100");
            toast.classList.add("opacity-0", "pointer-events-none");
          }, 2500);
        }
      });
    });
  </script>
</Layout>
