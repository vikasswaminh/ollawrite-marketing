---
import Layout from "../../layouts/Layout.astro";
import { BLOG_POSTS } from "../../data/blog";

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Render the lightweight markdown body into HTML blocks.
const renderBody = (body: string): string => {
  const escape = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  const inline = (s: string) =>
    escape(s)
      .replace(/\*\*(.+?)\*\*/g, "<strong class=\"font-bold text-ink\">$1</strong>")
      .replace(/\*(.+?)\*/g, "<em>$1</em>");

  const li = (item: string) => {
    const text = item.replace(/^-\s*/, "");
    return `<li class="flex gap-2.5 items-start"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span><span class="text-neutral-700">${inline(
      text
    )}</span></li>`;
  };

  const out: string[] = [];
  let list: string[] = [];
  const flushList = () => {
    if (list.length) {
      out.push(`<ul class="my-4 space-y-2.5 pl-2">${list.join("")}</ul>`);
      list = [];
    }
  };

  body.split("\n\n").forEach((block) => {
    const lines = block.split("\n");
    lines.forEach((line) => {
      const trimmed = line.trim();
      if (trimmed.startsWith("- ")) {
        list.push(li(trimmed));
        return;
      }
      flushList();

      if (trimmed.startsWith("### ")) {
        out.push(
          `<h3 class="mt-8 mb-3 text-xl font-bold text-ink sm:text-2xl">${inline(
            trimmed.replace("### ", "")
          )}</h3>`
        );
      } else if (trimmed.startsWith("## ")) {
        out.push(
          `<h2 class="mt-12 mb-4 text-2xl font-black tracking-tight text-ink sm:text-3xl border-b border-neutral-200 pb-3">${inline(
            trimmed.replace("## ", "")
          )}</h2>`
        );
      } else if (trimmed.startsWith("Who should use it:")) {
        out.push(
          `<div class="my-4 rounded-xl border border-emerald-200 bg-emerald-50/70 p-4 text-sm text-emerald-900"><strong class="font-bold text-emerald-800">Who should use it:</strong> ${inline(
            trimmed.replace(/^Who should use it:\s*/i, "")
          )}</div>`
        );
      } else if (trimmed.startsWith("Who should skip it:")) {
        out.push(
          `<div class="my-4 rounded-xl border border-amber-200 bg-amber-50/70 p-4 text-sm text-amber-900"><strong class="font-bold text-amber-800">Who should skip it:</strong> ${inline(
            trimmed.replace(/^Who should skip it:\s*/i, "")
          )}</div>`
        );
      } else if (trimmed) {
        out.push(`<p class="mt-4 leading-relaxed text-neutral-700">${inline(trimmed)}</p>`);
      }
    });
    flushList();
  });
  flushList();

  return out.join("");
};

const bodyHtml = renderBody(post.body);
---

<Layout title={`${post.title} — OllaWrite Journal`} description={post.excerpt}>
  <article class="bg-paper text-ink">
    <!-- Top bar -->
    <div class="border-b border-ink">
      <div class="wrap flex items-center justify-between py-4">
        <a
          href="/blog"
          class="flex items-center gap-1.5 text-sm font-bold text-neutral-600 hover:text-ink"
        >
          ← Back to Journal
        </a>
      </div>
    </div>

    <!-- Article header -->
    <div class="border-b border-ink bg-neutral-50">
      <div class="wrap py-12 lg:py-16">
        <span
          class="rounded-full border border-brand/30 bg-brand-tint px-2.5 py-0.5 text-xs font-bold text-brand"
        >
          {post.category}
        </span>
        <h1
          class="mt-4 max-w-3xl text-3xl font-black leading-[1.1] tracking-tight sm:text-4xl lg:text-5xl"
        >
          {post.title}
        </h1>
        <div
          class="mt-5 flex flex-wrap items-center gap-4 text-sm text-neutral-500"
        >
          <span class="font-bold text-neutral-700">{post.author.name}</span>
          <span>·</span>
          <span>{post.author.role}</span>
          <span>·</span>
          <span>{post.date}</span>
          <span>·</span>
          <span>{post.readTime}</span>
        </div>
      </div>
    </div>

    <!-- Body -->
    <div class="wrap max-w-3xl py-12 lg:py-16">
      <div
        class="space-y-5 text-base leading-relaxed text-neutral-700"
        set:html={bodyHtml}
      />

      <!-- Verification card -->
      <div class="mt-10 rounded-xl border border-neutral-200 bg-neutral-50 p-5">
        <div class="flex items-center justify-between text-sm">
          <span class="font-bold uppercase tracking-wider text-brand"
            >Editorial Grounding Certificate</span
          >
          <span class="flex items-center gap-1.5 font-bold text-emerald-700">
            ✓ Verified
          </span>
        </div>
        <p class="mt-2 text-sm text-neutral-600">
          This article was audited against public site architecture and verified
          for factual consistency before publication clearance.
        </p>
      </div>
    </div>
  </article>
</Layout>
