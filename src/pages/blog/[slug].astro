---
import Layout from "../../layouts/Layout.astro";
import { BLOG_POSTS } from "../../data/blog";

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const slugify = (s: string): string =>
  s
    .toLowerCase()
    .replace(/[’'"]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

// Render the lightweight markdown body into HTML blocks.
const renderBody = (body: string): { html: string; headings: { id: string; text: string }[] } => {
  const escape = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  const inline = (s: string) =>
    escape(s)
      .replace(
        /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
        '<a href="$2" class="font-semibold text-brand underline underline-offset-2 hover:opacity-80">$1</a>'
      )
      .replace(/\*\*(.+?)\*\*/g, '<strong class="font-bold text-ink">$1</strong>')
      .replace(/\*(.+?)\*/g, "<em>$1</em>");

  const li = (item: string) => {
    const text = item.replace(/^-\s*/, "");
    return `<li class="flex gap-3 items-start"><span class="mt-2.5 h-2 w-2 shrink-0 rounded-sm bg-brand ring-1 ring-ink"></span><span class="text-neutral-700">${inline(
      text
    )}</span></li>`;
  };

  const parseTable = (tableBlock: string) => {
    const lines = tableBlock.trim().split("\n").filter((l) => l.trim().startsWith("|"));
    if (lines.length < 2) return "";
    const headers = lines[0]
      .split("|")
      .map((s) => s.trim())
      .filter((_, i, arr) => i > 0 && i < arr.length - 1);
    const rows = lines
      .slice(2)
      .map((line) =>
        line
          .split("|")
          .map((s) => s.trim())
          .filter((_, i, arr) => i > 0 && i < arr.length - 1)
      );

    const ths = headers
      .map((h) => `<th class="px-5 py-3 font-black text-ink">${inline(h)}</th>`)
      .join("");
    const trs = rows
      .map((row, idx) => {
        const tds = row
          .map((cell, cIdx) => {
            const isFirst = cIdx === 0;
            return `<td class="px-5 py-3.5 ${isFirst ? "font-black text-ink" : "text-neutral-700"}">${inline(cell)}</td>`;
          })
          .join("");
        const bg = idx % 2 === 0 ? "bg-white" : "bg-neutral-50/70";
        return `<tr class="${bg} transition-colors hover:bg-brand-tint/30">${tds}</tr>`;
      })
      .join("");

    return `<div class="table-container my-8 overflow-hidden rounded-2xl border border-ink shadow-[4px_4px_0_0_#1d4ed8]">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] text-left text-sm">
          <thead>
            <tr class="border-b-2 border-ink bg-neutral-50 text-xs font-black uppercase tracking-wider text-neutral-600">
              ${ths}
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200">
            ${trs}
          </tbody>
        </table>
      </div>
    </div>`;
  };

  const out: string[] = [];
  const headings: { id: string; text: string }[] = [];
  let list: string[] = [];
  const flushList = () => {
    if (list.length) {
      out.push(`<ul class="my-6 space-y-3 pl-1">${list.join("")}</ul>`);
      list = [];
    }
  };

  body.split("\n\n").forEach((block) => {
    const trimmedBlock = block.trim();
    if (trimmedBlock.startsWith("|") && trimmedBlock.includes("\n|")) {
      flushList();
      out.push(parseTable(trimmedBlock));
      return;
    }

    const lines = block.split("\n");
    lines.forEach((line) => {
      const trimmed = line.trim();
      if (trimmed.startsWith("- ")) {
        list.push(li(trimmed));
        return;
      }
      flushList();

      if (trimmed.startsWith("### ")) {
        out.push(
          `<h3 class="mt-10 mb-3 text-xl font-bold text-ink sm:text-2xl">${inline(
            trimmed.replace("### ", "")
          )}</h3>`
        );
      } else if (trimmed.startsWith("## ")) {
        const text = trimmed.replace("## ", "");
        const id = slugify(text);
        headings.push({ id, text });
        out.push(
          `<h2 id="${id}" class="group mt-16 mb-5 scroll-mt-24 text-2xl font-black tracking-tight text-ink sm:text-3xl border-l-4 border-brand pl-4"><a href="#${id}" class="hover:text-brand">${inline(
            text
          )}</a><a href="#${id}" aria-label="Direct link to this section" class="ml-2 align-middle text-sm font-bold text-brand opacity-0 transition-opacity group-hover:opacity-100">#</a></h2>`
        );
      } else if (trimmed.startsWith("Who should use it:")) {
        out.push(
          `<div class="my-5 rounded-xl border border-blue-200 bg-blue-50/70 p-4 text-sm text-blue-950"><strong class="font-bold text-brand">Who should use it:</strong> ${inline(
            trimmed.replace(/^Who should use it:\s*/i, "")
          )}</div>`
        );
      } else if (trimmed.startsWith("Who should skip it:")) {
        out.push(
          `<div class="my-5 rounded-xl border border-amber-200 bg-amber-50/70 p-4 text-sm text-amber-900"><strong class="font-bold text-amber-800">Who should skip it:</strong> ${inline(
            trimmed.replace(/^Who should skip it:\s*/i, "")
          )}</div>`
        );
      } else if (trimmed) {
        out.push(`<p class="mt-5 text-[1.05rem] leading-8 text-neutral-700">${inline(trimmed)}</p>`);
      }
    });
    flushList();
  });
  flushList();

  return { html: out.join(""), headings };
};

const { html: bodyHtml, headings } = renderBody(post.body);

// TL;DR is the first section of the body when present; the rest are article sections.
const hasTldr = headings.length > 0 && headings[0].text === "TL;DR";
const articleHeadings = hasTldr ? headings.slice(1) : headings;

// Split body: TL;DR summary vs rest. Only the summary paragraphs (up to the
// OllaWrite plug paragraph) go inside the highlighted card; the intro
// paragraphs that follow stay in the normal article flow.
let tldrContent = "";
let restHtml = bodyHtml;
if (hasTldr) {
  const h2Tag = bodyHtml.match(/<h2 id="tl-dr"[^>]*>.*?<\/h2>/);
  const tldrH2Start = bodyHtml.indexOf('<h2 id="tl-dr"');
  const contentStart = tldrH2Start + (h2Tag ? h2Tag[0].length : 0);
  const boundary = articleHeadings.length
    ? bodyHtml.indexOf(`<h2 id="${articleHeadings[0].id}"`)
    : bodyHtml.length;
  const rawTldr = bodyHtml.slice(contentStart, boundary);
  const plugIdx = rawTldr.indexOf("ollawrite.com");
  const cutIdx =
    plugIdx > -1 ? rawTldr.indexOf("</p>", plugIdx) + "</p>".length : rawTldr.length;
  tldrContent = rawTldr.slice(0, cutIdx);
  restHtml = rawTldr.slice(cutIdx) + bodyHtml.slice(boundary);
}

const toc = hasTldr
  ? [{ id: "tl-dr", text: "TL;DR Summary" }, ...articleHeadings]
  : articleHeadings;

const firstSectionId = articleHeadings.length ? articleHeadings[0].id : "top";

const showQuickPicks = post.slug === "best-ai-writing-tools-in-2026";
const quickPicks = [
  { tool: "AI Assistant", bestFor: "Conversational drafting, code review & legal redlines", starting: "Reactive / Chat" },
  { tool: "Contextual Assistant", bestFor: "Workspace document synthesis & file ingestion", starting: "Reactive / Workspace" },
  { tool: "Advisory Agent", bestFor: "24/7 background audit, pipeline & anomaly monitoring", starting: "Proactive / Scheduled" },
  { tool: "Autonomous Agent", bestFor: "Multi-step tool execution with human approval gate", starting: "Proactive / Real Tools" },
];
---

<Layout title={`${post.title} — OllaWrite Journal`} description={post.excerpt}>
  <article class="bg-paper text-ink">
    <!-- Top bar -->
    <div class="border-b border-ink">
      <div class="wrap flex items-center justify-between py-4">
        <a
          href="/blog"
          class="flex items-center gap-1.5 text-sm font-bold text-neutral-600 hover:text-ink"
        >
          ← Back to Journal
        </a>
        <a
          href={`#${firstSectionId}`}
          class="flex items-center gap-1.5 text-sm font-bold text-brand hover:text-brand-deep"
        >
          Skip to the guide ↓
        </a>
      </div>
    </div>

    <!-- Article header -->
    <div class="border-b border-ink bg-neutral-50">
      <div class="wrap py-12 lg:py-16">
        <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-widest text-brand">
          <span class="rounded-full border border-brand/30 bg-brand-tint px-2.5 py-1">
            {post.category}
          </span>
          <span class="text-neutral-400">•</span>
          <span class="text-neutral-500">{post.date}</span>
          <span class="text-neutral-400">•</span>
          <span class="text-neutral-500">{post.readTime}</span>
        </div>
        <h1
          class="mt-5 max-w-4xl text-3xl font-black leading-[1.08] tracking-tight sm:text-4xl lg:text-[3.25rem]"
        >
          {post.title}
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-neutral-600">
          {post.excerpt}
        </p>
        <div class="mt-6 flex items-center gap-3 text-sm text-neutral-500">
          <span class="grid h-10 w-10 place-items-center rounded-full bg-brand text-sm font-black text-paper">OW</span>
          <div>
            <p class="font-bold text-neutral-800">{post.author.name}</p>
            <p class="text-xs">{post.author.role}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Body: sticky TOC sidebar + full-width content -->
    <div class="wrap py-12 lg:py-16">
      <div class="lg:flex lg:gap-10">
        <!-- TOC sidebar -->
        <aside class="mb-10 lg:mb-0 lg:w-72 lg:shrink-0">
          <nav class="rounded-2xl border border-ink bg-neutral-50 p-5 lg:sticky lg:top-6">
            <div class="flex items-center justify-between border-b border-neutral-200 pb-3">
              <h2 class="flex items-center gap-2 text-sm font-black uppercase tracking-widest text-ink">
                <span aria-hidden="true">☰</span> Table of Contents
              </h2>
              <span class="rounded-full bg-brand px-2.5 py-0.5 text-[0.65rem] font-bold text-white ring-1 ring-ink">
                {toc.length} Sections
              </span>
            </div>
            <ol class="mt-3.5 space-y-2 max-h-[70vh] overflow-y-auto pr-1">
              {
                toc.map((h, i) => (
                  <li>
                    <a
                      href={`#${h.id}`}
                      class="group flex items-center gap-2.5 rounded-xl border border-neutral-200 bg-white px-3 py-2.5 text-xs font-bold text-neutral-800 transition-all hover:-translate-y-0.5 hover:border-brand hover:bg-blue-50/70 hover:text-brand hover:shadow-[2px_2px_0_0_#1d4ed8]"
                    >
                      <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-blue-100 text-[0.65rem] font-black text-brand group-hover:bg-brand group-hover:text-white transition-colors">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <span class="flex-1 truncate leading-tight">{h.text}</span>
                      <span class="text-neutral-300 transition-transform group-hover:translate-x-0.5 group-hover:text-brand">→</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </aside>

        <!-- Article content -->
        <div class="min-w-0 flex-1 lg:max-w-[56rem]">
          {
            hasTldr && (
              <div>
                <section id="tl-dr" class="relative scroll-mt-24 overflow-hidden rounded-2xl border border-ink bg-brand-deep shadow-[8px_8px_0_0_#1d4ed8]">
                  <div class="h-1.5 bg-blue-500"></div>
                  <div class="p-6 sm:p-8">
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="rounded-md border border-blue-400/40 bg-blue-500/20 px-3 py-1 text-sm font-black uppercase tracking-widest text-blue-300">
                        TL;DR
                      </span>
                      <span class="text-xs font-bold uppercase tracking-widest text-blue-200">
                        Too long? Here's the whole article in 30 seconds
                      </span>
                    </div>
                    <div class="mt-4 border-l-4 border-blue-400 pl-5 tldr-body" set:html={tldrContent} />
                  </div>
                </section>

                {/* Quick Pick table only for BLOG1 */}
                {
                  showQuickPicks && (
                    <div class="mt-8 overflow-hidden rounded-2xl border border-ink shadow-[4px_4px_0_0_#1d4ed8]">
                      <div class="flex items-center justify-between bg-neutral-900 px-5 py-3">
                        <h3 class="text-sm font-black uppercase tracking-widest text-blue-300">
                          ⚡ Architecture Matrix — The 4 Tiers
                        </h3>
                        <span class="text-[0.65rem] font-bold uppercase tracking-widest text-neutral-400">
                          4 tiers
                        </span>
                      </div>
                      <div class="overflow-x-auto">
                        <table class="w-full min-w-[34rem] text-left text-sm">
                          <thead>
                            <tr class="border-b border-neutral-200 bg-neutral-50 text-xs font-black uppercase tracking-wider text-neutral-500">
                              <th class="px-5 py-3">Architecture</th>
                              <th class="px-5 py-3">Best for</th>
                              <th class="px-5 py-3">Execution Model</th>
                            </tr>
                          </thead>
                          <tbody>
                            {
                              quickPicks.map((row, i) => (
                                <tr class={i % 2 === 0 ? "bg-white" : "bg-neutral-50/60"}>
                                  <td class="px-5 py-3 font-black text-ink">{row.tool}</td>
                                  <td class="px-5 py-3 text-neutral-700">{row.bestFor}</td>
                                  <td class="px-5 py-3 font-semibold text-brand">{row.starting}</td>
                                </tr>
                              ))
                            }
                          </tbody>
                        </table>
                      </div>
                    </div>
                  )
                }

                {/* Interactive Chapter Box Grid */}
                <div class="mt-8 overflow-hidden rounded-2xl border border-ink bg-neutral-50 p-5 shadow-[4px_4px_0_0_#1d4ed8]">
                  <div class="flex items-center justify-between border-b border-neutral-200 pb-3">
                    <h3 class="flex items-center gap-2 text-sm font-black uppercase tracking-widest text-ink">
                      <span class="text-brand">☰</span> Table of Contents — Chapter Modules
                    </h3>
                    <span class="rounded-full bg-brand px-2.5 py-0.5 text-[0.65rem] font-bold text-white ring-1 ring-ink">
                      {articleHeadings.length} Chapters
                    </span>
                  </div>
                  <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    {
                      articleHeadings.map((h, i) => (
                        <a
                          href={`#${h.id}`}
                          class="group relative flex flex-col justify-between rounded-xl border border-neutral-200 bg-white p-3.5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-brand hover:bg-blue-50/60 hover:shadow-[3px_3px_0_0_#1d4ed8]"
                        >
                          <div class="flex items-center justify-between">
                            <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-blue-100 text-xs font-black text-brand transition-colors group-hover:bg-brand group-hover:text-white">
                              {String(i + 1).padStart(2, "0")}
                            </span>
                            <span class="text-xs font-bold text-neutral-400 transition-colors group-hover:text-brand">
                              Open →
                            </span>
                          </div>
                          <span class="mt-2.5 text-xs font-bold text-ink leading-snug transition-colors group-hover:text-brand">
                            {h.text}
                          </span>
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>
            )
          }

          <div set:html={restHtml} />

          <!-- Bottom quick action bar: direct link to TL;DR -->
          {
            hasTldr && (
              <div class="mt-12 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-ink bg-neutral-50 p-5 shadow-[4px_4px_0_0_#1d4ed8]">
                <div class="flex items-center gap-2 text-sm font-bold text-neutral-700">
                  <span class="grid h-6 w-6 place-items-center rounded-full bg-brand text-xs font-black text-white ring-1 ring-ink">⚡</span>
                  <span>Finished reading? Need a quick recap?</span>
                </div>
                <div class="flex items-center gap-3">
                  <a
                    href="#tl-dr"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-ink bg-brand px-4 py-2 text-xs font-black uppercase tracking-wider text-white shadow-[2px_2px_0_0_#0f172a] transition-all hover:-translate-y-0.5 hover:bg-brand-deep"
                  >
                    ↑ Jump back to 30-sec TL;DR
                  </a>
                  <a
                    href="https://login.ollawrite.com"
                    class="inline-flex items-center gap-1.5 rounded-lg border-2 border-brand bg-brand px-4 py-2 text-xs font-black uppercase tracking-wider text-white transition-colors hover:bg-brand-deep"
                  >
                    Audit your site free →
                  </a>
                </div>
              </div>
            )
          }

          <!-- Back to top -->
          <div class="mt-8 flex justify-center">
            <a
              href="#main"
              class="rounded-full border border-ink bg-paper px-5 py-2 text-xs font-black uppercase tracking-widest text-ink transition-colors hover:bg-brand hover:text-white"
            >
              ↑ Back to top
            </a>
          </div>

          <!-- Email signup (Small / Compact) -->
          <div class="mt-10 overflow-hidden rounded-xl border border-ink bg-brand-deep p-5 text-white shadow-[4px_4px_0_0_#1d4ed8]">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-[0.7rem] font-black uppercase tracking-widest text-blue-300">
                  The OllaWrite Journal
                </p>
                <h3 class="mt-0.5 text-base font-black text-white sm:text-lg">
                  Get weekly AI writing deep-dives in your inbox
                </h3>
              </div>
              <form
                action="https://login.ollawrite.com/register"
                method="get"
                class="flex items-center gap-2"
              >
                <label for="journal-email" class="sr-only">Email address</label>
                <input
                  id="journal-email"
                  type="email"
                  name="email"
                  required
                  placeholder="you@company.com"
                  class="w-48 sm:w-56 rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-xs text-white placeholder-blue-200 outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-400"
                />
                <button
                  type="submit"
                  class="whitespace-nowrap rounded-lg bg-brand px-4 py-2 text-xs font-bold text-white transition-transform hover:-translate-y-0.5 hover:bg-brand-deep"
                >
                  Sign up →
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  /* High contrast text inside the TL;DR box */
  .tldr-body,
  .tldr-body * {
    color: #ffffff !important;
  }
  .tldr-body p {
    margin-top: 0.75rem;
    font-size: 1.05rem;
    line-height: 1.8;
    font-weight: 500;
    color: #ffffff !important;
  }
  .tldr-body strong {
    color: #93c5fd !important;
  }
  .tldr-body a {
    color: #60a5fa !important;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tldr-body ul {
    margin: 1rem 0;
    display: grid;
    gap: 0.75rem;
  }
  .tldr-body li span {
    color: #ffffff !important;
    font-weight: 500;
  }
</style>

