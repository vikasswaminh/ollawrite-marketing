---
import Layout from "../../layouts/Layout.astro";
import { BLOG1_FULL_POST, BLOG2_FULL_POST, BLOG4_FULL_POST } from "../../data/blog";

const augustBlogs = [
  {
    post: BLOG1_FULL_POST,
    badge: "Tool Comparison & Benchmarks",
    words: "3,991 words",
    readTime: "24 min read",
    date: "Aug 19, 2026",
    color: "blue"
  },
  {
    post: BLOG2_FULL_POST,
    badge: "Architecture & Systems",
    words: "4,402 words",
    readTime: "23 min read",
    date: "Aug 21, 2026",
    color: "sky"
  },
  {
    post: BLOG4_FULL_POST,
    badge: "Comprehensive Pillar Guide",
    words: "4,417 words",
    readTime: "24 min read",
    date: "Aug 24, 2026",
    color: "indigo"
  }
];
---

<Layout
  title="August 2026 Editorial Collection — 3 Flagship Deep Dives | OllaWrite"
  description="The complete August 2026 publication archive featuring 3 comprehensive, unabridged research guides on AI writing tools, architectural systems, and generative engines."
>
  <div class="bg-paper text-ink min-h-screen">
    <!-- Top Bar Navigation -->
    <div class="border-b border-slate-200/80 bg-white/90 backdrop-blur-md sticky top-16 z-30 shadow-xs">
      <div class="wrap flex items-center justify-between py-3.5">
        <a
          href="/blog"
          class="flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-blue-600 transition-colors"
        >
          ← Back to Blog Index
        </a>
        <a
          href="https://www.ollawrite.com"
          class="flex items-center gap-1.5 text-xs font-bold text-blue-600 hover:text-blue-800 transition-colors"
        >
          Visit OllaWrite Home →
        </a>
      </div>
    </div>

    <!-- Hero Header -->
    <div class="relative border-b border-slate-200/80 bg-gradient-to-b from-blue-50/50 via-sky-50/30 to-white overflow-hidden py-14 lg:py-20">
      <div class="pointer-events-none absolute -top-24 right-1/4 h-96 w-96 rounded-full bg-blue-400/10 blur-3xl"></div>
      <div class="pointer-events-none absolute top-10 left-10 h-72 w-72 rounded-full bg-blue-500/10 blur-2xl"></div>

      <div class="wrap relative">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-4 py-1 text-xs font-bold text-blue-700 shadow-xs mb-4">
          <span>⚡</span>
          <span>Curated Monthly Archive • August 2026</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight max-w-3xl leading-[1.18]">
          The August 2026 Flagship Blog Collection
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
          The three long-form cornerstone guides published on OllaWrite in August 2026. Over 12,800 words of rigorous research, architectural breakdowns, and practical guidance on modern AI writing.
        </p>

        <!-- Stats row -->
        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-2xl">
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
            <p class="text-xs font-bold uppercase text-slate-500">Total Posts</p>
            <p class="mt-1 text-2xl font-black text-blue-600">3</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
            <p class="text-xs font-bold uppercase text-slate-500">Total Word Count</p>
            <p class="mt-1 text-2xl font-black text-blue-600">12,810+</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
            <p class="text-xs font-bold uppercase text-slate-500">Average Read Time</p>
            <p class="mt-1 text-2xl font-black text-blue-600">24 Min</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
            <p class="text-xs font-bold uppercase text-slate-500">Theme</p>
            <p class="mt-1 text-2xl font-black text-blue-600">Site-First</p>
          </div>
        </div>
      </div>
    </div>

    <!-- The 3 Stored Blogs -->
    <div class="wrap py-12 lg:py-16">
      <div class="space-y-10">
        {
          augustBlogs.map((item, index) => (
            <article class="group rounded-3xl border-2 border-slate-200 bg-white p-6 sm:p-10 shadow-sm transition-all duration-200 hover:border-blue-400 hover:shadow-xl relative overflow-hidden">
              <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-5 mb-6">
                <div class="flex items-center gap-3">
                  <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-blue-600 text-sm font-black text-white shadow-xs">
                    0{index + 1}
                  </span>
                  <span class="rounded-full bg-blue-50 border border-blue-200 px-3 py-1 text-xs font-bold text-blue-700">
                    {item.badge}
                  </span>
                </div>
                <div class="flex items-center gap-4 text-xs font-bold text-slate-500">
                  <span>📅 {item.date}</span>
                  <span>⏱️ {item.readTime}</span>
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 text-slate-700 font-bold">{item.words}</span>
                </div>
              </div>

              <div class="grid lg:grid-cols-[1fr_auto] gap-8 items-start">
                <div>
                  <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight group-hover:text-blue-600 transition-colors">
                    <a href={`/blog/${item.post.slug}`}>
                      {item.post.title}
                    </a>
                  </h2>
                  <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
                    {item.post.excerpt}
                  </p>

                  <div class="mt-6 flex flex-wrap items-center gap-3">
                    <a
                      href={`/blog/${item.post.slug}`}
                      class="inline-flex items-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-bold text-white shadow-md shadow-blue-500/20 transition-all hover:scale-105"
                    >
                      Read Complete Article →
                    </a>
                    <a
                      href={`/blog/${item.post.slug}#tldr`}
                      class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-slate-50 hover:bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition-colors"
                    >
                      <span>⚡</span> Jump to TL;DR
                    </a>
                    <a
                      href={`/blog/${item.post.slug}#faq`}
                      class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-slate-50 hover:bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition-colors"
                    >
                      <span>❓</span> View FAQs
                    </a>
                  </div>
                </div>

                <div class="hidden lg:flex flex-col items-center justify-center p-6 rounded-2xl bg-blue-50/50 border border-blue-100 text-center w-52 shrink-0">
                  <span class="text-3xl">📖</span>
                  <p class="mt-2 text-xs font-bold uppercase tracking-wider text-blue-900">Unabridged Guide</p>
                  <p class="mt-1 text-xs text-slate-600">100% full content with chapter TOC and interactive matrix.</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Bottom Archive Footer -->
      <div class="mt-14 rounded-3xl border-2 border-blue-400 bg-gradient-to-br from-blue-50/90 via-sky-50/80 to-blue-100/80 p-8 text-center">
        <h3 class="text-2xl font-black text-blue-950">Looking for more editorial research?</h3>
        <p class="mt-2 text-slate-700 max-w-xl mx-auto text-sm sm:text-base">
          Browse our complete journal for technical breakdowns on crawler architectures, entity mapping, and multi-agent governance.
        </p>
        <div class="mt-6 flex justify-center gap-4">
          <a
            href="/blog"
            class="rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-bold text-white shadow-md shadow-blue-500/20 transition-all hover:scale-105"
          >
            Explore Full Blog Index →
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
