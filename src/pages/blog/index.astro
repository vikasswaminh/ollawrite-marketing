---
import Layout from "../../layouts/Layout.astro";
import { BLOG_POSTS } from "../../data/blog";

const categories = [
  "All",
  "AI Tools & Strategy",
  "AI Writing & Strategy",
  "AI Workforce & Architecture",
  "Product & Research",
  "SEO & Strategy",
];

// 5 August blogs to be stored inside the August box
const augustSlugs = [
  "ai-writing-tools-vs-traditional-content-writing",
  "how-to-use-ai-to-write-seo-friendly-blog-posts",
  "ai-content-generator-complete-guide",
  "what-is-an-ai-content-writer",
  "best-ai-writing-tools-in-2026"
];

const augustPosts = augustSlugs.map(s => BLOG_POSTS.find(p => p.slug === s)).filter(Boolean);

// Remaining blogs outside the August box
const otherPosts = BLOG_POSTS.filter(p => !augustSlugs.includes(p.slug));
---

<Layout
  title="OllaWrite Journal — Editorial intelligence, technical search & verification"
  description="In-depth research on site-first AI writing, canonical SEO grounding, and multi-agent systems."
>
  <div class="bg-paper text-ink">
    <!-- Header bar -->
    <div class="border-b border-ink">
      <div class="wrap py-12 lg:py-16">
        <p class="eyebrow">OllaWrite Journal</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
          Editorial intelligence, technical search &amp; verification.
        </h1>
        <p class="mt-3 max-w-xl text-neutral-600">
          In-depth research on site-first AI writing, canonical SEO grounding,
          and multi-agent systems.
        </p>

        <!-- Filter bar -->
        <div
          class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex flex-wrap gap-2">
            {
              categories.map((cat, i) => (
                <button
                  type="button"
                  data-category={cat}
                  aria-pressed={i === 0 ? "true" : "false"}
                  class:list={[
                    "blog-filter rounded-full border px-3.5 py-1 text-xs font-bold transition-colors",
                    i === 0
                      ? "border-brand bg-brand text-white"
                      : "border-neutral-300 bg-paper text-neutral-700 hover:border-neutral-400",
                  ]}
                >
                  {cat}
                </button>
              ))
            }
          </div>
          <input
            id="blog-search"
            type="text"
            placeholder="Search articles…"
            class="w-full rounded-lg border border-neutral-300 px-3 py-1.5 text-sm text-ink placeholder-neutral-400 focus:border-brand focus:outline-none sm:w-64"
          />
        </div>
      </div>
    </div>

    <!-- Main Container -->
    <div class="wrap py-12">
      
      <!-- ==================================================== -->
      <!-- 1. AUGUST BLOG BOX (COLLAPSIBLE / STORED 5 BLOGS)   -->
      <!-- ==================================================== -->
      <section class="august-blog-box mb-16 rounded-3xl border-3 border-blue-600 bg-blue-50/40 p-6 sm:p-10 shadow-lg">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b-2 border-blue-200/80 pb-6">
          <div class="max-w-2xl">
            <div class="flex items-center gap-2 mb-2">
              <span class="rounded-full bg-blue-600 px-3 py-1 text-xs font-black uppercase text-white shadow-xs">
                August 2026 Edition
              </span>
              <span class="text-xs font-bold text-blue-800 bg-blue-100 border border-blue-300 px-2.5 py-0.5 rounded-full">
                5 Stored Guides
              </span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
              August Blogs &amp; In-Depth Research
            </h2>
            <p class="mt-1.5 text-slate-600 text-sm sm:text-base leading-relaxed">
              5 comprehensive guides published this August covering site-grounded AI writing, SEO ranking strategies, and AI content models in date order.
            </p>
          </div>

          <!-- Read More Button to Open the 5 Stored Blogs -->
          <div class="flex-shrink-0">
            <button
              id="toggle-august-blogs-btn"
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-sm sm:text-base font-bold text-white shadow-md transition-all hover:bg-blue-700 hover:scale-105 cursor-pointer active:scale-95"
            >
              <span id="august-btn-label">Read more</span>
              <span id="august-arrow-icon" class="text-lg leading-none font-black transition-transform duration-200">↓</span>
            </button>
          </div>
        </div>

        <!-- The 5 Stored August Blogs (Initially Hidden, Opened on Click) -->
        <div id="august-stored-blogs" class="hidden mt-8 transition-all duration-300">
          <div class="mb-5 flex items-center justify-between">
            <span class="text-xs uppercase tracking-wider font-bold text-blue-700 bg-blue-100/90 border border-blue-200 px-3 py-1 rounded-full">
              Showing All 5 August Blogs (Chronological Date Order)
            </span>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
              augustPosts.map((post, index) => (
                <article
                  class="card blog-card flex flex-col justify-between rounded-2xl border-2 border-blue-400 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:border-blue-600 hover:shadow-md"
                  data-category={post.category}
                  data-search={`${post.title} ${post.excerpt}`.toLowerCase()}
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 flex-wrap mb-2">
                      <span class="text-xs font-bold uppercase tracking-wider text-blue-700">
                        {post.category}
                      </span>
                      <span class="text-xs font-black text-blue-800 bg-blue-100 border border-blue-300 px-2 py-0.5 rounded">
                        {post.date}
                      </span>
                    </div>
                    <h3 class="mt-2 text-lg sm:text-xl font-black leading-snug text-slate-900">
                      <a
                        href={`/blog/${post.slug}`}
                        class="transition-colors hover:text-blue-600"
                      >
                        {post.title}
                      </a>
                    </h3>
                    <p class="mt-2.5 text-sm text-slate-600 line-clamp-3 leading-relaxed">
                      {post.excerpt}
                    </p>
                  </div>
                  <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 text-xs text-slate-500">
                    <span class="font-bold text-slate-700">
                      {post.readTime}
                    </span>
                    <a
                      href={`/blog/${post.slug}`}
                      class="inline-flex items-center gap-1 font-bold text-blue-600 hover:text-blue-800 hover:underline"
                    >
                      Read full guide →
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ==================================================== -->
      <!-- 2. REMAINING BLOGS (OUTSIDE THE AUGUST BOX)          -->
      <!-- ==================================================== -->
      <section class="other-blogs-section">
        <div class="mb-8 border-b border-neutral-300 pb-4">
          <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">
            All Architecture &amp; Technical Dispatches
          </h2>
          <p class="mt-1 text-neutral-600 text-sm sm:text-base">
            System architectures, multi-agent pipelines, and editorial governance.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            otherPosts.map((post) => (
              <article
                class="card blog-card flex flex-col justify-between p-6 transition-all hover:-translate-y-0.5 hover:shadow-[4px_4px_0_0_#1d4ed8]"
                data-category={post.category}
                data-search={`${post.title} ${post.excerpt}`.toLowerCase()}
              >
                <div>
                  <div class="flex items-center justify-between gap-2 flex-wrap mb-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-neutral-500">
                      {post.category}
                    </span>
                    <span class="text-xs font-medium text-neutral-400">
                      {post.date}
                    </span>
                  </div>
                  <h3 class="mt-2.5 text-lg font-bold leading-snug text-ink">
                    <a
                      href={`/blog/${post.slug}`}
                      class="transition-colors hover:text-brand"
                    >
                      {post.title}
                    </a>
                  </h3>
                  <p class="mt-2 text-sm text-neutral-600 line-clamp-3 leading-relaxed">
                    {post.excerpt}
                  </p>
                </div>
                <div class="mt-6 flex items-center justify-between border-t border-neutral-200 pt-4 text-xs text-neutral-500">
                  <span class="font-bold text-neutral-700">
                    {post.readTime}
                  </span>
                  <a
                    href={`/blog/${post.slug}`}
                    class="inline-flex items-center gap-1 font-bold text-brand hover:text-brand-deep hover:underline"
                  >
                    Read more →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <p id="blog-empty" class="hidden py-16 text-center text-neutral-500">
        No articles found.
      </p>
    </div>
  </div>

  <script>
    // 1. Toggle August Blogs Dropdown / Container
    const toggleBtn = document.getElementById("toggle-august-blogs-btn");
    const storedBlogsContainer = document.getElementById("august-stored-blogs");
    const btnLabel = document.getElementById("august-btn-label");
    const arrowIcon = document.getElementById("august-arrow-icon");

    if (toggleBtn && storedBlogsContainer && btnLabel && arrowIcon) {
      toggleBtn.addEventListener("click", () => {
        const isHidden = storedBlogsContainer.classList.contains("hidden");
        if (isHidden) {
          storedBlogsContainer.classList.remove("hidden");
          btnLabel.textContent = "Show less";
          arrowIcon.textContent = "↑";
        } else {
          storedBlogsContainer.classList.add("hidden");
          btnLabel.textContent = "Read more";
          arrowIcon.textContent = "↓";
        }
      });
    }

    // 2. Category Filter & Search
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".blog-filter")
    );
    const search = document.getElementById(
      "blog-search"
    ) as HTMLInputElement | null;
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".blog-card")
    );
    const empty = document.getElementById("blog-empty");

    let activeCategory = "All";

    const apply = () => {
      const q = (search?.value || "").toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const matchesCategory =
          activeCategory === "All" ||
          card.dataset.category === activeCategory;
        const matchesSearch = (card.dataset.search || "").includes(q);
        const show = matchesCategory && matchesSearch;
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      empty?.classList.toggle("hidden", visible !== 0);
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = btn.dataset.category || "All";
        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-pressed", String(active));
          b.classList.toggle("border-brand", active);
          b.classList.toggle("bg-brand", active);
          b.classList.toggle("text-white", active);
          b.classList.toggle("border-neutral-300", !active);
          b.classList.toggle("bg-paper", !active);
          b.classList.toggle("text-neutral-700", !active);
        });
        apply();
      });
    });

    search?.addEventListener("input", apply);
  </script>
</Layout>
