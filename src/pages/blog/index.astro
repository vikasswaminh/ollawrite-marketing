---
import Layout from "../../layouts/Layout.astro";
import { BLOG_POSTS } from "../../data/blog";

const categories = [
  "All",
  "AI Tools & Strategy",
  "AI Writing & Strategy",
  "AI Workforce & Architecture",
  "Product & Research",
  "SEO & Strategy",
];

const augustPosts = BLOG_POSTS;
const featuredPost = augustPosts[0];
const remainingAugustPosts = augustPosts.slice(1);
---

<Layout
  title="OllaWrite Journal — Editorial intelligence, technical search & verification"
  description="In-depth research on site-first AI writing, canonical SEO grounding, and multi-agent systems."
>
  <div class="bg-paper text-ink">
    <!-- Header bar -->
    <div class="border-b border-ink">
      <div class="wrap py-12 lg:py-16">
        <p class="eyebrow">OllaWrite Journal</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
          Editorial intelligence, technical search &amp; verification.
        </h1>
        <p class="mt-3 max-w-xl text-neutral-600">
          In-depth research on site-first AI writing, canonical SEO grounding,
          and multi-agent systems.
        </p>

        <!-- Filter bar -->
        <div
          class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex flex-wrap gap-2">
            {
              categories.map((cat, i) => (
                <button
                  type="button"
                  data-category={cat}
                  aria-pressed={i === 0 ? "true" : "false"}
                  class:list={[
                    "blog-filter rounded-full border px-3.5 py-1 text-xs font-bold transition-colors",
                    i === 0
                      ? "border-brand bg-brand text-white"
                      : "border-neutral-300 bg-paper text-neutral-700 hover:border-neutral-400",
                  ]}
                >
                  {cat}
                </button>
              ))
            }
          </div>
          <input
            id="blog-search"
            type="text"
            placeholder="Search articles…"
            class="w-full rounded-lg border border-neutral-300 px-3 py-1.5 text-sm text-ink placeholder-neutral-400 focus:border-brand focus:outline-none sm:w-64"
          />
        </div>
      </div>
    </div>

    <!-- August Blogs Section -->
    <div class="wrap py-12">
      <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between border-b-2 border-brand/20 pb-6 gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="rounded-full bg-brand px-3 py-0.5 text-xs font-black uppercase text-white">
              August 2026 Edition
            </span>
            <span class="text-xs font-bold text-neutral-500">5 In-Depth Guides</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">
            August Blogs &amp; Technical Dispatches
          </h2>
          <p class="mt-1.5 text-neutral-600 max-w-2xl">
            All 5 comprehensive August 2026 guides organized strictly in date order.
          </p>
        </div>
      </div>

      <!-- 1. Featured Latest August Dispatch (26-08-2026) -->
      <article
        class="card blog-card mb-10 overflow-hidden p-6 shadow-[4px_4px_0_0_#1d4ed8] sm:p-8"
        data-category={featuredPost.category}
        data-search={`${featuredPost.title} ${featuredPost.excerpt}`.toLowerCase()}
      >
        <div class="grid gap-8 lg:grid-cols-[2fr_1fr]">
          <div>
            <div class="flex items-center gap-2">
              <span
                class="rounded-full border border-brand/30 bg-brand-tint px-3 py-0.5 text-xs font-bold text-brand"
              >
                {featuredPost.category}
              </span>
              <span class="rounded-full bg-brand px-2.5 py-0.5 text-[0.65rem] font-bold uppercase text-white ring-1 ring-ink">
                Latest Dispatch
              </span>
            </div>
            <h2
              class="mt-3 text-2xl font-black leading-snug tracking-tight sm:text-3xl"
            >
              <a
                href={`/blog/${featuredPost.slug}`}
                class="transition-colors hover:text-brand"
              >
                {featuredPost.title}
              </a>
            </h2>
            <p class="mt-3 text-neutral-600 leading-relaxed">{featuredPost.excerpt}</p>
            <div class="mt-5 flex items-center gap-3 text-sm text-neutral-500">
              <span class="font-bold text-ink">{featuredPost.author.name}</span>
              <span>·</span>
              <span class="font-bold text-brand bg-blue-50 px-2 py-0.5 rounded border border-blue-200">{featuredPost.date}</span>
              <span>·</span>
              <span>{featuredPost.readTime}</span>
            </div>
          </div>
          <div
            class="flex flex-col justify-between rounded-xl border border-brand/20 bg-brand-tint p-5"
          >
            <div>
              <span
                class="text-xs font-bold uppercase tracking-widest text-brand"
                >Key Takeaways</span
              >
              <ul class="mt-3 space-y-2 text-sm text-neutral-700">
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 font-bold text-brand">✓</span>
                  <span>Hybrid workflows: AI velocity + human domain expertise</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 font-bold text-brand">✓</span>
                  <span>Site-grounded drafting vs prompt guessing breakdown</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 font-bold text-brand">✓</span>
                  <span>The economics and quality gates of modern publishing</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 font-bold text-brand">✓</span>
                  <span>Direct ranking strategies for organic visibility</span>
                </li>
              </ul>
            </div>
            <a
              href={`/blog/${featuredPost.slug}`}
              class="mt-5 inline-flex items-center justify-center gap-2 rounded-lg border-2 border-brand bg-brand px-5 py-2.5 text-center text-sm font-bold text-white transition-all hover:border-brand-deep hover:bg-brand-deep hover:shadow-md"
            >
              Read full guide →
            </a>
          </div>
        </div>
      </article>

      <!-- 2. Grid of Remaining 4 August Blogs in Date Order -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
        {
          remainingAugustPosts.map((post, idx) => (
            <article
              class="card blog-card flex flex-col justify-between p-6 transition-all hover:-translate-y-0.5 hover:shadow-[4px_4px_0_0_#1d4ed8]"
              data-category={post.category}
              data-search={`${post.title} ${post.excerpt}`.toLowerCase()}
            >
              <div>
                <div class="flex items-center justify-between gap-2 flex-wrap mb-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-brand">
                    {post.category}
                  </span>
                  <span class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded">
                    {post.date}
                  </span>
                </div>
                <h3 class="mt-2 text-xl font-bold leading-snug">
                  <a
                    href={`/blog/${post.slug}`}
                    class="transition-colors hover:text-brand"
                  >
                    {post.title}
                  </a>
                </h3>
                <p class="mt-2.5 text-sm text-neutral-600 line-clamp-3 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>
              <div class="mt-6 flex items-center justify-between border-t border-neutral-200 pt-4 text-xs text-neutral-500">
                <span class="font-bold text-neutral-700">
                  {post.readTime}
                </span>
                <a
                  href={`/blog/${post.slug}`}
                  class="inline-flex items-center gap-1 font-bold text-brand hover:text-brand-deep hover:underline"
                >
                  Read full guide →
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <p id="blog-empty" class="hidden py-16 text-center text-neutral-500">
        No articles found.
      </p>
    </div>
  </div>

  <script>
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".blog-filter")
    );
    const search = document.getElementById(
      "blog-search"
    ) as HTMLInputElement | null;
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".blog-card")
    );
    const empty = document.getElementById("blog-empty");

    let activeCategory = "All";

    const apply = () => {
      const q = (search?.value || "").toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const matchesCategory =
          activeCategory === "All" ||
          card.dataset.category === activeCategory;
        const matchesSearch = (card.dataset.search || "").includes(q);
        const show = matchesCategory && matchesSearch;
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      empty?.classList.toggle("hidden", visible !== 0);
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = btn.dataset.category || "All";
        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-pressed", String(active));
          b.classList.toggle("border-brand", active);
          b.classList.toggle("bg-brand", active);
          b.classList.toggle("text-white", active);
          b.classList.toggle("border-neutral-300", !active);
          b.classList.toggle("bg-paper", !active);
          b.classList.toggle("text-neutral-700", !active);
        });
        apply();
      });
    });

    search?.addEventListener("input", apply);
  </script>
</Layout>
