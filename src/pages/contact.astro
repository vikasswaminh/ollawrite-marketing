---
import Layout from "../layouts/Layout.astro";

/* PLACEHOLDER — swap for the real inbox before launch. */
const EMAIL = "hello@ollawrite.com";
---

<Layout
  title="Contact — OllaWrite"
  description="Get in touch with the OllaWrite team."
>
  <section class="border-b border-ink">
    <div class="wrap grid gap-12 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">
          Get in touch
        </h1>
        <p class="mt-5 max-w-md text-lg text-neutral-700">
          Questions about what OllaWrite does, or whether it fits how your team
          already works? Send a note.
        </p>

        <div class="mt-8 space-y-4">
          <div class="card p-5">
            <p class="eyebrow">Email</p>
            <a
              href={`mailto:${EMAIL}`}
              class="mt-1 block font-bold hover:underline">{EMAIL}</a
            >
          </div>
          <div class="card p-5">
            <p class="eyebrow">Already a customer?</p>
            <a
              href="https://login.ollawrite.com"
              class="mt-1 block font-bold hover:underline"
              >Sign in at login.ollawrite.com</a
            >
          </div>
        </div>
      </div>

      <div>
        <div
          class="mb-6 rounded-lg border-2 border-amber-700 bg-neutral-50 p-4"
          role="note"
        >
          <p class="text-sm text-neutral-700">
            <strong class="font-bold text-amber-700">Heads up:</strong> this form
            is not connected to anything yet. Email
            <a href={`mailto:${EMAIL}`} class="font-bold underline">{EMAIL}</a>
            and it will actually reach us.
          </p>
        </div>

        <!--
          Deliberately inert: no action, no backend. Submitting explains that
          rather than showing a success message for a message that was
          silently discarded.
        -->
        <form id="contact-form" class="card space-y-5 p-6" novalidate>
          <div>
            <label for="name" class="block text-sm font-bold">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              class="mt-1.5 w-full rounded-lg border border-ink bg-paper px-3.5 py-2.5 text-ink placeholder:text-neutral-500"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-bold">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              class="mt-1.5 w-full rounded-lg border border-ink bg-paper px-3.5 py-2.5 text-ink placeholder:text-neutral-500"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-bold">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              class="mt-1.5 w-full resize-y rounded-lg border border-ink bg-paper px-3.5 py-2.5 text-ink placeholder:text-neutral-500"
            ></textarea>
          </div>

          <button
            type="submit"
            class="rounded-lg border-2 border-ink bg-ink px-6 py-2.5 font-bold text-paper hover:bg-neutral-800"
            >Send</button
          >

          <p
            id="form-status"
            class="text-sm text-neutral-600 empty:hidden"
            role="status"
            aria-live="polite"
          >
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const status = document.getElementById("form-status");
    if (status) {
      // Never claim it was sent. Nothing received it.
      status.textContent =
        "This form isn't wired up yet — nothing was sent. Please email hello@ollawrite.com instead.";
    }
  });
</script>
