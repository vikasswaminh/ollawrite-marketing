---
const path = Astro.url.pathname;
const APP = "https://login.ollawrite.com";

const links = [
  { href: "/#features", label: "Features" },
  { href: "/#how", label: "How it works" },
  { href: "/#pricing", label: "Pricing" },
  { href: "/#faq", label: "FAQ" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
];

const isContact = path.startsWith("/contact");
const isBlog = path.startsWith("/blog");
---

<header
  class="sticky top-0 z-40 border-b border-ink bg-paper/90 backdrop-blur-sm"
>
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-black tracking-tight">
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-brand text-paper text-sm font-black"
        aria-hidden="true">O</span
      >
      <span class="text-lg">OllaWrite</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={
              (l.href === "/contact" && isContact) ||
              (l.href === "/blog" && isBlog)
                ? "page"
                : undefined
            }
            class="rounded-md px-3 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-100 hover:text-ink"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={APP}
        class="hidden rounded-lg px-3 py-2 text-sm font-bold text-neutral-700 hover:text-ink sm:inline-block"
        >Sign in</a
      >
      <a
        href={APP}
        class="rounded-lg border-2 border-brand bg-brand px-4 py-2 text-sm font-bold text-paper hover:border-brand-deep hover:bg-brand-deep"
        >Start writing</a
      >
    </div>
  </div>
</header>
